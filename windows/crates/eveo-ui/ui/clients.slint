//
// 「客户端」页，对应 macOS 的 ClientsPage：「全部隐藏」开关、在线客户端与配置里出现过的角色。
// 每个角色一张卡片：在线状态、角色名、按角色的高亮颜色、「显示缩略图」开关；各列宽度固定，不同长度的角色名之间对齐。
// 登录界面的客户端没有角色名，不能按角色设置，只列出来供核对。
//
// 数据放在全局 ClientsModel 里，由 Rust 的 bind.rs 按协调器的状态填入。角色列表的颜色与开关双向绑定到列表的行，
// 用户改动后经回调通知 Rust（带角色名，不带下标：列表可能在两次轮询之间重排）。
// 「全部隐藏」的快捷键在这里只显示，修改放在「切换与热键」页，两处是同一份配置。

import { Button, LineEdit, Switch } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Footnote, PageHeader, RowGap, SectionHeader, SettingRow } from "components.slint";

// 一个角色的行。
export struct CharacterRow {
    // 角色名（区分大小写，与配置里的键一致）。
    name: string,
    // 是否有客户端在线。
    online: bool,
    // 输入框里的文字：按角色的高亮颜色，空串表示跟随「预览与布局」页的高亮颜色。用户输入时直接改这一列。
    color: string,
    // 配置里当前的值（规范写法）。Rust 只在它变了时改写 color：用户输到一半时，轮询引起的刷新不会冲掉输入。
    applied: string,
    // 样本颜色：按角色的颜色，或者跟随的全局颜色。
    swatch: color,
    // 是否显示缩略图（与配置的隐藏名单相反）。
    shown: bool,
}

// 本页的数据。
export global ClientsModel {
    // 「全部隐藏」：本次会话有效，不写进配置。
    in-out property <bool> hide-all;
    // 「全部隐藏」快捷键的界面写法，多条用顿号隔开；没有时为空串。
    in property <string> hide-all-hotkeys;
    // 全部已知角色，按名称排序。
    in-out property <[CharacterRow]> characters;
    // 在线的登录与未知客户端的标题（`EVE`、`EVE (<pid>)`）。
    in property <[string]> login-clients;
    // 跟随时显示的全局高亮颜色，作为颜色输入框的提示文字。
    in property <string> default-highlight: "#ADFF2F";
    // 用户切换了「全部隐藏」。
    callback hide-all-toggled(bool);
    // 用户切换了某个角色的「显示缩略图」。
    callback shown-toggled(string, bool);
    // 用户改了某个角色的颜色文字（可能还没输完）。
    callback color-edited(string, string);
    // 用户点了某个角色的「默认」：回到跟随全局颜色。
    callback color-reset(string);
}

// 角色卡片。列从左到右：在线状态、角色名、颜色（样本、输入框、「默认」按钮）、「显示缩略图」与开关。
// 角色名占满剩余宽度，其余各列宽度固定，所以各行的颜色块与开关上下对齐。
component CharacterCard inherits Rectangle {
    // 角色名。
    in property <string> name;
    // 是否在线。
    in property <bool> online;
    // 颜色文字，与列表的行双向绑定。
    in-out property <string> hex;
    // 样本颜色。
    in property <color> swatch;
    // 显示缩略图，与列表的行双向绑定。
    in-out property <bool> shown;
    min-height: 56px;
    background: Theme.card;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.card-border;
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;
        // 在线状态：绿点在线，灰点离线；点的大小与 macOS 相同。
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: online ? #3fb950 : Theme.divider;
                border-width: online ? 0px : 1px;
                border-color: Theme.text-secondary;
            }
        }
        // 角色名占满剩余宽度；过长时末尾省略。离线的角色用次要文字色。
        Text {
            text: name;
            color: online ? Theme.text : Theme.text-secondary;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        // 颜色列：样本、输入框与「默认」按钮，固定宽度。
        HorizontalLayout {
            width: 250px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.divider;
                    background: swatch;
                }
            }
            // 空串时提示跟随的全局颜色；输完整的 #RRGGBB 才会采用。
            // 输入框与按钮各自竖直居中，不随卡片拉高。
            VerticalLayout {
                alignment: center;
                LineEdit {
                    text <=> root.hex;
                    placeholder-text: "跟随 " + ClientsModel.default-highlight;
                    width: 130px;
                    edited(text) => {
                        ClientsModel.color-edited(root.name, text);
                    }
                }
            }
            // 「默认」：只在设了按角色颜色时可点。
            VerticalLayout {
                alignment: center;
                Button {
                    text: "默认";
                    enabled: root.hex != "";
                    clicked => {
                        ClientsModel.color-reset(root.name);
                    }
                }
            }
        }
        // 「显示缩略图」文字与开关分开放，各行的文字位置一致。
        Text {
            text: "显示缩略图";
            color: Theme.text-secondary;
            font-size: 12px;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Switch {
                checked <=> root.shown;
            toggled => {
                    ClientsModel.shown-toggled(root.name, root.shown);
                }
            }
        }
    }
}

// 只有一行说明的卡片：没有角色时、登录客户端用。
component NoteCard inherits Rectangle {
    // 说明文字。
    in property <string> text;
    min-height: 48px;
    background: Theme.card;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.card-border;
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        Text {
            text: root.text;
            color: Theme.text-secondary;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}

// 「客户端」页。
export component ClientsPage inherits VerticalLayout {
    alignment: start;
    PageHeader {
        title: "客户端";
        subtitle: "在线的客户端与出现过的角色：按角色设置高亮颜色、显示或隐藏缩略图";
    }

    // 「全部隐藏」开关与快捷键。
    SettingRow {
        title: "隐藏全部缩略图";
        description: "只在本次运行中有效，重新启动后恢复显示";
        Switch {
            checked <=> ClientsModel.hide-all;
            toggled => {
                ClientsModel.hide-all-toggled(ClientsModel.hide-all);
            }
        }
    }
    RowGap { }
    SettingRow {
        title: "快捷键";
        description: "在「切换与热键」页修改";
        Text {
            text: ClientsModel.hide-all-hotkeys == "" ? "未设置" : ClientsModel.hide-all-hotkeys;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }
    }

    SectionHeader { text: "角色"; }
    if ClientsModel.characters.length == 0: NoteCard {
        text: "还没有角色。登录游戏后，角色会出现在这里。";
    }
    for row in ClientsModel.characters: VerticalLayout {
        // 卡片之间 4px 的缝，与设置行相同。
        padding-bottom: 4px;
        CharacterCard {
            name: row.name;
            online: row.online;
            hex <=> row.color;
            swatch: row.swatch;
            shown <=> row.shown;
        }
    }
    Footnote {
        text: "关掉「显示缩略图」的角色记在配置里，以后上线也不显示；颜色留空时用「预览与布局」页的高亮颜色。";
    }

    if ClientsModel.login-clients.length > 0: SectionHeader { text: "登录界面的客户端"; }
    for title in ClientsModel.login-clients: VerticalLayout {
        padding-bottom: 4px;
        NoteCard { text: title; }
    }
    Rectangle { height: 24px; }
}
