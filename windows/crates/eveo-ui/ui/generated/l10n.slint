    // 滚动到最新。
    in property <string> menu-scroll-to-latest: "Scroll to Latest";
    // 复制光标下的那一条。
    in property <string> menu-copy-line: "Copy This Line";
    // 「在浏览器中打开」子菜单（6.9 节增补）。
    in property <string> menu-open-in-browser: "Open in Browser";
    // 清空活动角色在这个浮窗里的列表。
