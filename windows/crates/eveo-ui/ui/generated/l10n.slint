    // 锁定布局（带勾选）。
    in property <string> menu-lock-layout: "Lock Layout";
    // 恢复默认位置与尺寸。
    in property <string> menu-reset-frame: "Reset Position and Size";
    // 隐藏此浮窗（关掉这个功能）。
    in property <string> menu-hide: "Hide This Overlay";
    // 打开设置窗口的对应页。
    in property <string> menu-open-settings: "Open Settings…";
    // 一组的标题。
    in property <string> overlay-header: "Overlay";
    // 背景不透明度。
    in property <string> opacity: "Background Opacity";
    // 字号。
    in property <string> font-size: "Font Size";
    // 「恢复默认位置」按钮。
    in property <string> reset-frame: "Reset Position";
    // 手势说明。
    in property <string> gesture-help: "Right-drag or Option-drag to move the overlay, move the pointer to an edge and left-drag to resize, and scroll to browse the list.";
    // 「显示范围」单选的标签，v1.2.1。
    in property <string> visibility-label: "Show";
    // 「始终显示」选项（仍受「离开 EVE 时隐藏」约束），v1.2.1。
    in property <string> visibility-always: "Always";
    // 「仅游戏内」选项：游戏窗口都不在前台时隐藏，v1.2.1。
    in property <string> visibility-game-only: "Only in EVE: hide when no EVE window is in front";
    // 「位置」一行的标签（X、Y 两个数字框），v1.2.1。
    in property <string> position-label: "Position";
    // 「尺寸」一行的标签（宽、高两个数字框），v1.2.1。
    in property <string> size-label: "Size";
    // 位置与尺寸的说明：坐标原点、单位、尺寸上下限与拉回屏幕的规则，v1.2.1。
    in property <string> frame-help: "Position is measured in points from the top-left corner of the main display. Size is limited to 220×120 through 900×900; an off-screen position is pulled back.";
    // 一组的标题。
    in property <string> channels-header: "Channels";
    // 「从日志添加」菜单。
    in property <string> add-from-logs: "Add from Logs";
    // 「按名称添加」输入框的占位文字。
    in property <string> add-by-name-placeholder: "Type a channel name and press Return";
    // Windows「翻译」页：频道列表下添加内置频道（本地、军团、联盟、舰队）的一行的名字。
    in property <string> add-built-in: "Add a built-in channel";
    // Windows：频道列表下按名称添加一行的名字。
    in property <string> add-by-name: "Add by name";
    // Windows：「从日志添加」下拉框的第一项（提示文字），列表里是日志目录最近 14 天出现过、还没选的频道。
    in property <string> pick-from-logs: "Choose a channel from your logs…";
    // 「移除」按钮。
    in property <string> remove-channel: "Remove";
    // 列表为空时的说明。
    in property <string> no-channels: "No channels yet";
    // 菜单末尾的「刷新」。
    in property <string> refresh-channels: "Refresh";
    // 日志里没有最近的聊天日志时，菜单里置灰的一项。
    in property <string> no-discovered-channels: "No recent chat logs found";
    // 菜单项里频道名后面的「N 个角色」。
    pure callback channel-listeners(count: int) -> string;
    // 内置频道：本地。
    in property <string> built-in-local: "Local";
    // 内置频道：军团。
    in property <string> built-in-corp: "Corp";
    // 内置频道：联盟。
    in property <string> built-in-alliance: "Alliance";
    // 内置频道：舰队。
    in property <string> built-in-fleet: "Fleet";
}

// 翻译域的文字。
export global TranslationText {
    // 页标题下的一句说明。
    in property <string> page-subtitle: "Translates messages in other languages from the chosen channels.";
    // 总开关。
    in property <string> enable-toggle: "Show translation overlay";
    // 状态行的标签。
    in property <string> status-label: "Status";
    // 状态：未启用。
    in property <string> status-off: "Off";
    // 状态：就绪。
    in property <string> status-idle: "Ready";
    // 状态：翻译中。
    in property <string> status-translating: "Translating";
    // 状态：几秒后重试，附原因。
    pure callback status-waiting(seconds: int, reason: string) -> string;
    // 状态：已暂停，附原因。
    pure callback status-blocked(reason: string) -> string;
    // 「立即重试」按钮。
    in property <string> retry-now: "Retry Now";
    // 没有接口地址。
    in property <string> failure-missing-base-url: "No API address set";
    // 没有模型名。
    in property <string> failure-missing-model: "No model name set";
    // 接口地址的格式不对。
    in property <string> failure-invalid-url: "The API address is not valid";
    // 公网的 http 地址。
    in property <string> failure-insecure-http: "http addresses are only allowed for this Mac or the local network";
    // 没有 Key。
    in property <string> failure-missing-key: "No API key set";
    // 读不到钥匙串里的 Key。
    in property <string> failure-keychain: "Cannot read the key from Windows Credential Manager; save it again on the Translation page";
    // Key 无效，附状态码。
    pure callback failure-unauthorized(status: int) -> string;
    // 地址或模型名不对。
    in property <string> failure-not-found: "Wrong API address or model name (HTTP 404)";
    // 余额不足。
    in property <string> failure-balance: "Insufficient balance (HTTP 402)";
    // 请求被拒绝，附状态码与服务给的说明。
    pure callback failure-rejected(status: int, message: string) -> string;
    // 限流或额度用完。
    in property <string> failure-rate-limited: "Rate limited or out of quota (HTTP 429)";
    // 服务出错，附状态码。
    pure callback failure-server(status: int) -> string;
    // 连不上。
    in property <string> failure-network: "Cannot reach the model service";
    // 答复的格式不对。
    in property <string> failure-malformed: "The model did not answer in the expected format";
    // 模型拒绝了这批消息。
    in property <string> failure-refused: "The model declined these messages";
    // 答复被截断。
    in property <string> failure-truncated: "The model's answer was cut off";
    // 频道列表的说明。
    in property <string> channels-help: "Choose the channels to translate.";
    // 目标语言一组的标题。
    in property <string> target-header: "Target Language";
    // 「翻译成」。
    in property <string> target-language: "Translate into";
    // 「跟随界面语言」。
    in property <string> target-follow-ui: "Same as interface language";
    // 「同时显示原文」。
    in property <string> show-original: "Also show original text";
    // 「只显示翻译过的消息」。
    in property <string> foreign-only: "Only show translated messages";
    // 模型一组的标题。
    in property <string> model-header: "Model";
    // 「服务」。
    in property <string> provider: "Service";
    // 「其他（OpenAI 兼容接口）」。
    in property <string> provider-custom: "Other (OpenAI-compatible)";
    // 「接口地址」。
    in property <string> base-url: "API Address";
    // 「模型名」。
    in property <string> model: "Model Name";
    // 「API Key」。
    in property <string> api-key: "API Key";
    // 「已保存在钥匙串」。
    in property <string> api-key-stored: "Saved in Windows Credential Manager";
    // Key 输入框的占位文字。
    in property <string> api-key-placeholder: "Paste the key, then click Save";
    // 「保存」。
    in property <string> save-key: "Save";
    // 「删除 Key」。
    in property <string> delete-key: "Delete Key";
    // 「这个服务不用 Key」。
    in property <string> key-not-required: "This service needs no key";
    // 自定义接口：要 Key 时填写，不要时留空。
    in property <string> key-optional: "Enter a key if the service needs one; otherwise leave it empty.";
    // 钥匙串写入或删除失败，附 OSStatus。
    pure callback keychain-error(status: int) -> string;
    // 「测试」。
    in property <string> test: "Test";
    // 「测试中…」。
    in property <string> testing: "Testing…";
    // 测试成功，附译文。
    pure callback test-succeeded(text: string) -> string;
    // 测试失败，附原因。
    pure callback test-failed(reason: string) -> string;
    // 译文缓存一组的标题。
    in property <string> cache-header: "Translation Cache";
    // 缓存的条数。
    pure callback cache-count(count: int) -> string;
    // 「清空缓存」。
    in property <string> clear-cache: "Clear Cache";
    // 页尾的隐私说明。
    in property <string> privacy-note: "Message text from these channels is sent to the model service you choose. The key is stored only in this PC's Windows Credential Manager and sent only to that service.";
    // 页尾的费用说明。
    in property <string> cost-note: "Only messages received by the active client's character are translated. Identical sentences are translated once.";
    // 浮窗标题，附角色名。
    pure callback overlay-title(character: string) -> string;
    // 状态行：没有设置翻译频道。
    in property <string> status-no-channels: "No translation channels set";
    // 等待翻译的状态词。
    in property <string> pending: "translating…";
    // 翻译失败的状态词。
    in property <string> failed: "not translated";
}

// 更新域的全部文字。
export global UpdateText {
    // 工具项「检查更新…」。
    in property <string> menu-check-for-updates: "Check for Updates…";
    // 顶部的提示项：有可用更新，参数是新版本号。
    pure callback menu-update-available(version: string) -> string;
    // 顶部的提示项：新版本已下载好，点击后安装并重新启动；参数是新版本号。更新窗口的同名按钮也用它。
    pure callback menu-restart-to-update(version: string) -> string;
    // 一组的标题。
    in property <string> section-header: "Updates";
    // 「自动检查更新」开关。
    in property <string> auto-check-toggle: "Check for updates automatically";
    // 「自动检查更新」的说明。
    in property <string> auto-check-help: "Contacts GitHub once a day. No personal data is sent.";
    // 「自动安装更新」开关。
    in property <string> auto-install-toggle: "Install updates automatically";
    // 「自动安装更新」的说明。
    in property <string> auto-install-help: "Downloads in the background. Installs and restarts when no EVE client has been running for a minute, or installs when you quit EVE-O Preview.";
    // Windows 测试版：更新功能还没做，「通用」页更新一组下的说明。
    in property <string> not-available-yet: "Updates arrive in a later test build. Until then, download new versions from the GitHub releases page.";
    // 「当前版本」一行的标签。
    in property <string> current-version-label: "Current version";
    // 「上次检查」一行的标签。
    in property <string> last-checked-label: "Last checked";
    // 从来没有检查过。
    in property <string> last-checked-never: "Never";
    // 「立即检查」按钮；更新窗口在空闲时也用它。
    in property <string> check-now-button: "Check Now";
    // 检查中。
    in property <string> status-checking: "Checking…";
    // 已是最新版本。
    in property <string> status-up-to-date: "EVE-O Preview is up to date.";
    // 有新版本，参数是版本号。
    pure callback status-available(version: string) -> string;
    // 新版本已下载，退出时安装；参数是版本号。
    pure callback status-ready(version: string) -> string;
    // GitHub 限流，参数是可以再试的时刻（已按界面语言格式化）。
    pure callback status-rate-limited(time: string) -> string;
    // GitHub 限流，可以再试的时刻未知。
    in property <string> status-rate-limited-later: "GitHub is limiting requests. Try again later.";
    // 这个构建整个停用更新功能（不是从 .app 运行）。
    in property <string> status-unavailable: "Updates are not available in this build.";
    // 窗口标题。
    in property <string> window-title: "Software Update";
    // 标题行，参数是新版本号。
    pure callback headline(version: string) -> string;
    // 标题下一行，参数是正在运行的版本。
    pure callback current-version-line(version: string) -> string;
    // 发布说明上方的小标题。
    in property <string> release-notes-header: "What's New";
    // 跳过了几个版本时，每个版本的说明前的小标题，参数是版本号（8.8 节）。
    pure callback version-notes-title(version: string) -> string;
    // 中间版本没有列全时，说明最后的一行：更早版本的内容请看发布页。
    in property <string> earlier-versions-on-release-page: "Changes in earlier versions are on the release page.";
    // 「安装更新」按钮。
    in property <string> install-button: "Install Update";
    // 「安装更新」下方的说明。
    in property <string> install-help: "The app restarts after installing. Thumbnails disappear for a few seconds.";
    // 「跳过此版本」按钮。
    in property <string> skip-button: "Skip This Version";
    // 「稍后」按钮。
    in property <string> later-button: "Later";
    // 「打开发布页」按钮。
    in property <string> open-release-page-button: "Open Release Page";
    // 「取消」按钮。
    in property <string> cancel-button: "Cancel";
    // 「关闭」按钮。
    in property <string> close-button: "Close";
    // 「重试」按钮。
    in property <string> retry-button: "Try Again";
    // 核对中。
    in property <string> progress-verifying: "Verifying…";
    // 安装中。
    in property <string> progress-installing: "Installing…";
    // 重新启动中。
    in property <string> progress-relaunching: "Restarting…";
    // 使用测试地址时标题旁的字样。
    in property <string> test-feed-badge: "Test feed";
    // 只提示时，原因前面的一句。
    in property <string> notify-only-intro: "This copy can't update itself.";
    // 失败时：当前版本没有变化。
    in property <string> current-version-unchanged: "Your current version is unchanged.";
    // 安装成功但重新启动失败时的说明。
    in property <string> reopen-manually: "The update is installed. Quit and open EVE-O Preview again.";
    // `translocated`。
    in property <string> blocker-translocated: "macOS is running the app from a temporary read-only location. Move it to the Applications folder, then open it again.";
    // `readOnlyVolume`。
    in property <string> blocker-read-only-volume: "The app is on a read-only disk. Copy it to the Applications folder first.";
    // `locationNotWritable`。
    in property <string> blocker-location-not-writable: "You don't have permission to change the folder that contains the app.";
    // `unsupportedVolume`。
    in property <string> blocker-unsupported-volume: "The app is on a disk that is not formatted as APFS, so updates cannot be installed in the app. Download the new version from the release page.";
    // `adHocSignature`。
    in property <string> blocker-ad-hoc-signature: "This build has no stable signature, so a new version can't be verified against it.";
    // `developmentSignature`。
    in property <string> blocker-development-signature: "This is a locally signed development build.";
    // `unsigned`。
    in property <string> blocker-unsigned: "This build isn't signed.";
    // Windows 的 `noSigningKey`：这个构建没有内置核对更新包签名的公钥（本机编译的构建）。
    in property <string> blocker-no-signing-key: "This build doesn't include the key needed to verify updates.";
    // Windows 的 `developmentBuild`：调试版或 PR 构建，不自动安装正式版。
    in property <string> blocker-development-build: "This is a development build.";
    // `network`。
    in property <string> error-network: "Couldn't reach GitHub. Check your internet connection.";
    // `httpStatus`，参数是状态码。
    pure callback error-http-status(code: int) -> string;
    // `malformedFeed`。
    in property <string> error-malformed-feed: "The release information couldn't be read.";
    // `assetMissing`。
    in property <string> error-asset-missing: "This release has no installer for automatic updates.";
    // `insufficientDiskSpace`、`downloadTooLarge`。
    in property <string> error-disk-space: "There isn't enough free disk space for the download.";
    // `checksumListInvalid`、`checksumEntryMissing`、`checksumMismatch`。
    in property <string> error-checksum: "The download doesn't match its checksum and was discarded.";
    // `imageMountFailed`、`appMissingInImage`。
    in property <string> error-disk-image: "The downloaded disk image couldn't be opened.";
    // `signatureInvalid`、`requirementNotSatisfied`、`bundleMismatch`、`versionMismatch`、`notNewer`。
    in property <string> error-verification: "The new version couldn't be verified, so it wasn't installed.";
    // `unsupportedSystem`，参数是要求的最低系统版本。
    pure callback error-unsupported-system(minimum: string) -> string;
    // `swapFailed`。
    in property <string> error-swap-failed: "The app couldn't be replaced.";
    // Windows：自动检查发现新版本时托盘通知的正文（标题是 headline）。点通知会打开软件更新窗口。
    in property <string> notification-body: "Click to see what's new and install.";
}
