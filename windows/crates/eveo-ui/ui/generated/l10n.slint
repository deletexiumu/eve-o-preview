    in property <string> relaunch-hint: "Relaunch after granting Screen Recording";
    // 重新启动本应用的按钮。
    in property <string> relaunch: "Relaunch";
    // 代码签名与授权的说明（小字）。
    in property <string> signing-hint: "macOS records permissions by code signature. Ad-hoc builds need re-granting after every rebuild; see the README for a self-signed certificate.";
    // 版本一行的标签。
    in property <string> version: "Version";
    // 没有 Info.plist（`swift run`）时显示的版本。
    in property <string> dev-version: "Development build";
    // 应用名下方的一句话介绍。
    in property <string> about-subtitle: "Live thumbnails and fast switching for multiple EVE Online clients, native on Windows.";
    // 功能概述。
    in property <string> about-summary: "One live thumbnail per client, click to switch, cycle-group hotkeys and multiple profiles.";
    // 「上游项目与许可证」组的标题。
    in property <string> upstream-header: "Upstream & License";
    // 与上游项目的关系。
    in property <string> upstream-text: "This app re-implements the features of EveOPlus/eve-o-preview from scratch; none of its source code was ported.";
    // 许可证说明。
    in property <string> license-text: "Like upstream, it is released under the GNU General Public License v3.0.";
    // 「说明」组的标题。
    in property <string> disclaimer-header: "Notes";
    // 只切换焦点、不广播输入、不碰游戏内存。
    in property <string> focus-only-text: "This tool only switches window focus. It never broadcasts input to multiple clients and never reads or modifies game memory.";
    // 战斗提醒只读游戏日志（反馈文档 R17）。
    in property <string> game-log-text: "Combat alerts only read the game log files that the EVE client writes. They never read game memory, modify files or send input.";
    // 联网说明：只在检查和下载更新时访问 GitHub，可在「通用」页关闭；问题报告不会自动发送（v1.1 设计 10.1 节）。
    in property <string> network-text: "EVE-O Preview contacts GitHub only to check for and download updates; you can turn this off under General. Problem reports are never sent automatically.";
    // CCP 的商标声明。
    in property <string> eve-ip-text: "EVE Online and related logos are trademarks of CCP ehf. This project is not affiliated with or endorsed by CCP.";
    // 预警与翻译只读聊天日志和游戏日志；翻译会把聊天内容发给用户选择的模型服务（R32、R38）；
    in property <string> about-chat-logs-note: "Intel and translation only read chat logs and game logs. Translation sends chat text to the model service you choose. When online name checking is on, pilot names that run together in intel messages are sent to CCP's ESI API.";
    // 两个功能都没开、没有在读聊天日志。
    in property <string> chat-log-status-stopped: "Off";
    // 正在监视聊天日志目录，跟踪 files 个文件。
    pure callback chat-log-status-watching(directory: string, files: int) -> string;
    // 找不到聊天日志目录。
    pure callback chat-log-status-directory-not-found(path: string) -> string;
    // 没有读取聊天日志目录的权限。
    pure callback chat-log-status-access-denied(path: string) -> string;
    // 说明：EVE 客户端要开启把聊天写入文件的设置；日志目录在「提醒」页设置（用该语言的提醒页页名）。
    in property <string> chat-log-help: "The EVE client must be set to log chat to file. The log folder is set on the Alerts page.";
    // Windows「环境检查」页：页头的说明。
    in property <string> environment-subtitle: "Checks privileges, window mode and log folders to find out why thumbnails or hotkeys misbehave.";
    // Windows「环境检查」页：权限一组的标题。
    in property <string> privilege-header: "Privileges";
    // Windows「环境检查」页：本工具以什么权限运行的一行。
    in property <string> self-privilege: "EVE-O Preview runs as";
    // Windows「环境检查」页：以管理员权限运行。
    in property <string> privilege-admin: "Administrator";
    // Windows「环境检查」页：以普通权限运行。
    in property <string> privilege-standard: "Standard user";
    // Windows「环境检查」页：以管理员权限运行的客户端一行的名字。
    in property <string> elevated-clients: "Clients running as administrator";
    // Windows「环境检查」页：没有以管理员权限运行的客户端。
    in property <string> elevated-none: "None";
    // Windows「环境检查」页：有客户端以管理员权限运行、本工具不是时的说明。
    in property <string> elevated-warning: "These clients run as administrator but EVE-O Preview does not: Windows won't let it switch to them, and hotkeys don't work while they are in front. Run both with the same privileges, preferably without administrator rights.";
    // Windows「环境检查」页：窗口模式一组的标题。
    in property <string> window-mode-header: "Window mode";
    // Windows「环境检查」页：EVE 显示模式的建议一行的名字。
    in property <string> window-mode-label: "Use Fixed Window or Windowed mode";
    // Windows「环境检查」页：窗口模式的说明。
    in property <string> window-mode-help: "Choose it in EVE's display settings. In exclusive fullscreen, thumbnails may not show and switching clients flickers the screen.";
    // Windows「环境检查」页：文件夹存在。
    in property <string> folder-found: "Found";
    // Windows「环境检查」页：文件夹不存在。
    in property <string> folder-missing: "Not found";
    // Windows「环境检查」页：聊天日志文件夹一行的名字；括号里的文件夹名不翻译。
    in property <string> chatlogs-folder: "Chat logs (Chatlogs)";
    // Windows「环境检查」页：游戏日志文件夹一行的名字；括号里的文件夹名不翻译。
    in property <string> gamelogs-folder: "Game logs (Gamelogs)";
    // Windows「环境检查」页：日志目录一组的说明。
    in property <string> logs-help: "Intel and translation read Chatlogs; combat alerts read Gamelogs. If they are missing, make sure EVE logs chat to file, or set the log folder on the Alerts page.";
    // Windows「环境检查」页：重新检查的按钮。
    in property <string> recheck: "Check again";
    // Windows「环境检查」页：「重新检查」按钮旁的上次检查时间，参数是本地时间（时:分:秒）。
    pure callback last-checked(time: string) -> string;
}

// 「提醒」页的文字。
export global CombatText {
    // 页标题下的一句说明。
    in property <string> page-subtitle: "Flash a character's thumbnail when it comes under attack.";
    // 总开关。
    in property <string> enable-toggle: "Flash thumbnail when a character is attacked";
    // Windows「提醒」页：总开关的说明。
    in property <string> enable-help: "Applies to the current profile";
    // 状态行的标签。
    in property <string> status-label: "Status";
    // 状态：未启用。
    in property <string> status-stopped: "Off";
    // Windows 测试版：读游戏日志还没做，状态行的说明。
    in property <string> not-available-yet: "Reading game logs arrives in a later test build; use Test Flash to preview the effect";
    // 状态：监视中，附目录与跟踪的文件数。
    pure callback status-watching(directory: string, files: int) -> string;
    // 状态：找不到日志目录，附查找的路径。
    pure callback status-directory-not-found(path: string) -> string;
    // 状态：没有访问权限，附目录。
    pure callback status-access-denied(path: string) -> string;
    // 没有访问权限时的说明（「文件与文件夹」权限）。
    in property <string> access-denied-help: "Allow EVE-O Preview to access the Documents folder in System Settings > Privacy & Security > Files and Folders.";
    // 「打开系统设置」按钮。
    in property <string> open-system-settings: "Open System Settings…";
    // 日志目录一组的标题。
    in property <string> log-directory-header: "Game logs";
    // 日志目录一行的标签。
    in property <string> log-directory-label: "Folder";
    // Windows「提醒」页：日志目录一行的说明。
    in property <string> log-directory-help: "Leave blank to find it automatically; EVE's logs or logs\\Gamelogs folder both work";
    // 没有指定目录时，路径后面的「自动」标注。
    in property <string> automatic-suffix: "(automatic)";
    // Windows「提醒」页：目录输入框为空时的占位文字，参数是自动找到的位置。
    pure callback automatic-path(path: string) -> string;
    // 「选择…」按钮。
    in property <string> choose-directory: "Choose…";
    // 「使用自动位置」按钮。
    in property <string> use-automatic-location: "Use Automatic Location";
    // 选择目录的对话框里的说明。
    in property <string> choose-directory-message: "Choose the EVE \"logs\" or \"Gamelogs\" folder.";
    // 外观一组的标题。
    in property <string> appearance-header: "Flash";
    // 闪烁颜色。
    in property <string> flash-color: "Flash color";
    // 持续时间。
    in property <string> duration: "Duration";
    // Windows「提醒」页：持续时间一行的说明。
    in property <string> duration-help: "How long to flash after each hit; keeps going while hits continue";
    // 秒数的显示，如「3.5 秒」。
    pure callback seconds(value: float) -> string;
    // 样式。
    in property <string> style: "Style";
    // Windows「提醒」页：样式一行的说明。
    in property <string> style-help: "Border flashes the outline; Tint colors the whole thumbnail";
    // 样式：边框。
    in property <string> style-border: "Border";
    // 样式：底色。
    in property <string> style-wash: "Tint";
    // 样式：两者。
    in property <string> style-both: "Both";
    // 触发条件一组的标题。
    in property <string> triggers-header: "Triggers";
    // 「未命中的攻击也提醒」开关。
    in property <string> include-misses: "Also alert on attacks that miss";
    // Windows「提醒」页：未命中也提醒一行的说明。
    in property <string> include-misses-help: "Also flash when an attack misses";
    // 最小伤害。
    in property <string> minimum-damage: "Minimum damage";
    // 最小伤害的说明。
    in property <string> minimum-damage-help: "Hits below this amount are ignored. Misses follow the switch above.";
    // Windows「提醒」页：测试一组的标题。
    in property <string> test-header: "Test";
    // 「测试闪烁」按钮。
    in property <string> test-flash: "Test Flash";
    // 「测试闪烁」的说明。
    in property <string> test-flash-help: "Flashes every thumbnail once, even when the alert is off.";
    // 页尾的说明：游戏日志的设置与只读的承诺。
    in property <string> footnote: "Alerts apply to every client, including the one in front. This feature only reads the game logs and never sends any input to the game.";
}

// 诊断域的文字。
export global DiagnosticsText {
    // 工具项「报告问题…」。
    in property <string> menu-report-problem: "Report a Problem…";
    // 顶部的提示项：上次意外退出，点开报告。
    in property <string> menu-crash-pending: "EVE-O Preview quit unexpectedly — Report…";
    // 一组的标题。
    in property <string> section-header: "Diagnostics";
    // 「详细日志」开关。
    in property <string> verbose-logging-toggle: "Verbose logging";
    // 「详细日志」的说明。
    in property <string> verbose-logging-help: "Writes more detail to the log file. Turn it on before you reproduce a problem.";
    // 日志文件位置一行的标签。
    in property <string> log-location-label: "Log files";
    // 「在访达中显示日志」按钮。
    in property <string> show-logs-button: "Show Logs in File Explorer";
    // 「报告问题…」按钮。
    in property <string> report-button: "Report a Problem…";
    // 窗口标题。
    in property <string> window-title: "Report a Problem";
    // 手动情境的说明。
    in property <string> intro: "This creates a zip file with the items below. Nothing is sent automatically: you attach the file to a GitHub issue yourself.";
    // 崩溃情境的说明。
    in property <string> crash-intro: "EVE-O Preview quit unexpectedly last time. A report helps to fix the cause.";
    // 脱敏的说明。
    in property <string> redaction-note: "Your Windows user name, computer name and EVE character names are replaced with placeholders.";
    // 文件列表的标题。
    in property <string> items-header: "Included in the report";
    // `summary.md`。
    in property <string> item-summary: "Environment summary";
    // `config-summary.json`。
    in property <string> item-config: "Settings summary (no names)";
    // 日志文件。
    in property <string> item-log: "App log";
    // 第 number 个崩溃报告。
    pure callback item-crash(number: int) -> string;
    // `manifest.json`。
    in property <string> item-manifest: "File list";
    // 预览只显示了开头时的说明。
    in property <string> preview-truncated: "Only the first part is shown. The report contains the whole file.";
    // 替换次数，如「12 replacements」。
    pure callback replacements(count: int) -> string;
    // 收集中的进度文字。
    in property <string> collecting: "Collecting…";
    // 「生成报告并打开 GitHub」。
    in property <string> create-and-open-button: "Create Report and Open GitHub";
    // 「只生成报告」。
    in property <string> create-only-button: "Create Report Only";
    // 「取消」（手动情境）。
    in property <string> cancel-button: "Cancel";
    // 「以后再说」（崩溃情境）。
    in property <string> not-now-button: "Not Now";
    // 「不报告」（崩溃情境）。
    in property <string> dont-report-button: "Don't Report";
    // 完成页的标题。
    in property <string> done-title: "Report created";
    // 完成页的说明：把 zip 拖进浏览器里的 Issue 页面。
    in property <string> done-help: "File Explorer shows the zip file. Drag it into the issue page in your browser, describe what happened, then submit.";
    // 「在访达中显示」。
    in property <string> reveal-button: "Show in File Explorer";
    // 「再次打开 GitHub」。
    in property <string> open-issue-button: "Open GitHub Again";
    // 「关闭」。
    in property <string> close-button: "Close";
    // 生成失败，附原因（系统的说明，不翻译）。
    pure callback create-failed(reason: string) -> string;
}

// 热键域的全部文字。
export global HotkeyText {
    // 页首的副标题。
    in property <string> switching-subtitle: "Cycle groups and hotkeys. Each hotkey has exactly one scope: Global (including in EVE) or Only in EVE.";
    // 循环组一节的标签。
    in property <string> cycle-groups-header: "Cycle groups";
    // 「新建循环组」按钮。
    in property <string> add-group: "New Cycle Group";
    // Windows：「新建循环组」一行的说明。
    in property <string> add-group-help: "Cycles through a set of characters in order, with forward and backward hotkeys";
    // 没有循环组时的说明。
    in property <string> no-groups: "No cycle groups yet.";
    // 循环组名称一行的标签与占位文字。
    in property <string> group-name: "Name";
    // 「删除循环组」按钮。
    in property <string> delete-group: "Delete Group";
    // 前进热键一行的标签。
    in property <string> forward-hotkeys: "Forward hotkeys";
    // 后退热键一行的标签。
    in property <string> backward-hotkeys: "Backward hotkeys";
    // 循环组没有成员时的说明。
    in property <string> no-members: "No members yet. Add characters from the list at the top right.";
    // 「添加成员」菜单。
    in property <string> add-member: "Add Member";
    // Windows：循环组卡片里成员列表的标题。
    in property <string> members-header: "Members (in cycle order)";
    // Windows：成员上移一位的按钮。
    in property <string> move-up: "Move up";
    // Windows：成员下移一位的按钮。
    in property <string> move-down: "Move down";
    // 新循环组的默认名称，参数是序号。
    pure callback new-group-name(index: int) -> string;
    // 角色直达热键一节的标题。
    in property <string> character-hotkeys-header: "Character hotkeys";
    // 全部隐藏、全部最小化、登录客户端循环三项所在一节的标题。
    in property <string> global-hotkeys-header: "General hotkeys";
    // 「显示或隐藏全部缩略图」一行的标签。
    in property <string> hotkey-toggle-hide-all: "Show or hide all thumbnails";
    // 「全部最小化」一行的标签。
    in property <string> hotkey-minimize-all: "Minimize all clients";
    // 「登录客户端之间循环」一行的标签。
    in property <string> hotkey-cycle-login: "Cycle login-screen clients";
    // 热键规则的说明：键盘热键的修饰键要求，鼠标按键可以单独使用、触发时点击不传给游戏。
    in property <string> hotkey-rules-hint: "Keyboard hotkeys need Ctrl, Alt or Win, except F1–F20 and keypad digits; system shortcuts such as Alt+Tab and Win+L cannot be used. Only the middle and two side mouse buttons are supported; recorded mouse hotkeys default to Only in EVE so other programs keep their side buttons.";
    // 鼠标热键的说明：需要辅助功能权限，全局范围的鼠标热键在所有应用里吞掉按键，先取消别处的绑定。
    in property <string> mouse-hotkey-hint: "Mouse hotkeys need Accessibility permission. A mouse button set to Global is swallowed in every app. Remove other bindings of the button in the game or in your mouse software first.";
    // 页首「热键的默认作用范围」一行的标签。
    in property <string> default-scope-label: "Default hotkey scope";
    // 作用范围 global 的名称。
    in property <string> scope-global: "Global";
    // 作用范围 game 的名称。
    in property <string> scope-game: "Only in EVE";
    // 单选按钮里 global 一项的文字：名称加一句说明，讲清全局也包括游戏内。
    in property <string> scope-global-option: "Global: works in every app, including EVE";
    // 单选按钮里 game 一项的文字：名称加一句说明，讲清只在 EVE 窗口位于前台时生效。
    in property <string> scope-game-option: "Only in EVE: works only while an EVE window is in front";
    // 「切换与热键」页首默认范围下方的说明：每个热键只有一种范围，热键旁的标记显示并可单独修改它。
    in property <string> default-scope-footer: "Hotkeys set to “Use Default” follow this choice; hotkeys with their own Global or Only in EVE scope ignore it. A newly recorded mouse button gets its own Only in EVE scope, so it doesn’t swallow that button in other apps (such as the browser’s Back button).";
    // 每行作用范围菜单的第 1 项「跟随默认」，参数是当前默认范围的名称。
    pure callback scope-follow-default(current: string) -> string;
    // 作用范围菜单的提示文字，参数是这一行已解析的作用范围名称。
    pure callback scope-menu-help(resolved: string) -> string;
    // Windows：每行作用范围下拉框的第 2 项，这一个热键单独设为全局，不跟随默认。要短（下拉框约 170px 宽）。
    in property <string> scope-override-global: "Own: Global";
    // Windows：每行作用范围下拉框的第 3 项，这一个热键单独设为仅游戏内，不跟随默认。要短。
    in property <string> scope-override-game: "Own: Only in EVE";
    // Windows：默认范围下方的提示，参数是单独设了范围、不跟随默认的热键条数（至少 1）。
    pure callback scope-override-count(count: int) -> string;
    // Windows：把所有单独设了范围的热键改回跟随默认的按钮。
    in property <string> reset-scopes-to-default: "Make All Use Default";
    // 菜单栏菜单的一项：勾选时当前配置方案的默认作用范围是 game。
    in property <string> menu-hotkeys-only-in-eve: "Hotkeys Only in EVE";
    // 「添加」按钮。
    in property <string> add-hotkey: "Add hotkey";
    // 录制中按钮上的提示。
    in property <string> recording-prompt: "Press keys…";
    // Windows：「添加热键」按钮录制中的文字，提示 Esc 取消。
    in property <string> recording-prompt-esc: "Press keys… (Esc to cancel)";
    // 录制按钮的提示文字。
    in property <string> recorder-help: "Click, then press a key combination or a middle or side mouse button. Esc cancels, Delete clears.";
    // 删除按钮的提示文字。
    in property <string> remove-hotkey: "Remove this hotkey";
    // 字符串无法解析。
    in property <string> hotkey-unparsable: "Unrecognized";
    // 键盘热键缺修饰键。
    in property <string> hotkey-missing-modifier: "Needs a modifier";
    // 系统保留的组合。
    in property <string> hotkey-reserved: "Reserved by macOS";
    // Windows：热键问题，鼠标按键不支持（只支持中键与两个侧键）。要短。
    in property <string> hotkey-unsupported-mouse-button: "Middle and side buttons only";
    // 鼠标热键：没有辅助功能权限。
    in property <string> hotkey-accessibility-required: "Needs Accessibility";
    // 鼠标热键：有权限，但系统没有建出事件监听。
    in property <string> hotkey-event-tap-unavailable: "Can't monitor the mouse";
    // 与另一个动作重复，参数是那个动作的名称。
    pure callback hotkey-duplicate(other: string) -> string;
    // Carbon 注册失败，参数是错误码。
    pure callback hotkey-registration-failed(status: int) -> string;
    // Windows：热键问题，注册失败（多半被别的程序占用）。要短。
    in property <string> hotkey-in-use: "In use by another program";
    // Windows「客户端」页：一条热键与它的作用范围，如「F13（仅游戏内）」。
    pure callback hotkey-with-scope(hotkey: string, scope: string) -> string;
}

// 预警域的全部文字。
export global IntelText {
    // 页标题下的一句说明。
    in property <string> page-subtitle: "Reads intel channel logs and shows where hostiles are, how many, what ships, and how far.";
    // 总开关「显示预警浮窗」。
    in property <string> enable-toggle: "Show intel overlay";
    // 状态行的标签。
    in property <string> status-label: "Status";
    // 频道列表下的说明。
    in property <string> channels-help: "Choose the channels where hostiles are reported.";
    // 一组的标题。
    in property <string> location-header: "My Location";
    // 一组的说明。
    in property <string> location-help: "Location comes from jump records in the game log and from the Local channel log. Enter it here when neither is available.";
    // 位置未知。
    in property <string> location-unknown: "Unknown";
    // 位置的文字：星系（来源，多久以前）。
    pure callback location-value(system: string, source: string, age: string) -> string;
    // 来源：游戏日志。
    in property <string> source-game-log: "game log";
    // 来源：本地频道。
    in property <string> source-local: "Local channel";
    // 来源：手动。
    in property <string> source-manual: "manual";
    // 星系输入框的占位文字。
    in property <string> system-placeholder: "Type a system name and press Return";
    // 「清除」按钮。
    in property <string> clear-location: "Clear";
    // 输入的星系名查不到。
    in property <string> system-not-found: "System not found";
    // 没有在线的角色。
    in property <string> no-online-characters: "No characters online";
    // 参考星系一行的标签。
    in property <string> reference-system: "Reference System";
    // 参考星系的说明。
    in property <string> reference-system-help: "Jumps are counted from the reference system when a character's location is unknown.";
    // 一组的标题。
    in property <string> display-header: "Display";
    // 「保留最近」。
    in property <string> window-minutes: "Keep the last";
    // 分钟数，如「30 分钟」。
    pure callback minutes(count: int) -> string;
    // 「最多计算」。
    in property <string> max-jumps: "Count up to";
    // 跳数的单位，如「15 跳」。
    pure callback jumps-unit(count: int) -> string;
    // 「高亮距离」。
    in property <string> alert-jumps: "Highlight Within";
    // 高亮距离的说明。
    in property <string> alert-jumps-help: "Reports within this many jumps are highlighted. Set to 0 to turn highlighting off.";
    // 「显示原文」开关。
    in property <string> show-original: "Show original text";
    // 星图数据一行的标签。
    in property <string> static-data-label: "Map Data";
    // SDE 版本号。
    pure callback static-data-build(build: int) -> string;
    // 缺少星图数据。
    in property <string> static-data-missing: "Map data is missing; systems and ships cannot be recognized";
    // 页尾的说明。
    in property <string> footnote: "This feature only reads chat logs and game logs and sends no input to the game. Pilot names and counts are inferred from message format and may be wrong. Online name checking only shows that a character with that name exists, not that the message refers to that character.";
    // 浮窗标题，参数是活动角色名。
    pure callback overlay-title(character: string) -> string;
    // 状态行：缺少星图数据。
    in property <string> status-no-static-data: "Map data missing";
    // 状态行：没有预警频道。
    in property <string> status-no-channels: "No intel channels set";
    // 状态行：位置未知。
    in property <string> status-location-unknown: "Location unknown; right-click to open settings";
    // 状态行：位置未知，按参考星系计算。
    pure callback status-using-reference(system: string) -> string;
    // 状态行：位置（星系、来源、多久以前）。
    pure callback status-location(system: string, source: string, age: string) -> string;
    // 不足 1 分钟的时间，如「40 秒」。
    pure callback age-seconds(count: int) -> string;
    // 1 分钟以上的时间，如「3 分钟」。
    pure callback age-minutes(count: int) -> string;
    // 跳数，如「3 跳」。
    pure callback jumps(count: int) -> string;
    // 就在本星系（0 跳）。
    in property <string> jumps-here: "here";
    // 超过上限。
    pure callback jumps-beyond(limit: int) -> string;
    // 没有星门。
    in property <string> jumps-unreachable: "no gates";
    // 不知道从哪里算。
    in property <string> jumps-unknown: "?";
    // 写明的数量，如「×3」。
    pure callback count(value: int) -> string;
    // 推断的数量，如「约 ×3」。
    pure callback count-inferred(value: int) -> string;
    // 「安全」。
    in property <string> clear: "clear";
    // 「未见」。
    in property <string> no-visual: "no visual";
    // 开关「联网核对人名（ESI）」；措辞与 settings.aboutChatLogsNote 里引用的名称一致。
    in property <string> resolve-pilots-toggle: "Check pilot names online (ESI)";
    // 开关下的说明。
    in property <string> resolve-pilots-help: "When several names with spaces run together, asks CCP's ESI API which characters they are. Only those words are sent, not the speaker, the channel name, or your character names. Single-word names are not looked up.";
    // 核对状态一行的标签。
    in property <string> pilot-lookup-label: "Name Check";
    // 就绪，附已保存的角色名个数。
    pure callback pilot-lookup-idle(count: int) -> string;
    // 核对中。
    in property <string> pilot-lookup-resolving: "Checking";
    // 暂时连不上，附多少秒后重试。
    pure callback pilot-lookup-waiting(seconds: int) -> string;
    // 「清空人名缓存」按钮。
    in property <string> clear-pilot-cache: "Clear Name Cache";
    // 人名缓存一行：已保存的角色名个数（WP-B 增加的一条）。
    pure callback pilot-cache-count(count: int) -> string;
}

// 浮窗与两页共用设置控件的文字。
