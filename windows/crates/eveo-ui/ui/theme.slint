//
// 设置窗口的配色（明暗两套），数值取自 Windows 11 设置应用的观感。各页与控件都从这里取颜色。
// 只放颜色，不放尺寸：尺寸写在各控件里，跟着控件的结构走更容易读。
// std-widgets 的控件（开关、滑块、输入框）用 Palette 的配色，由设置窗口在明暗切换时同步。

// 明暗两套颜色。数值取自 Windows 11 设置应用的观感。
export global Theme {
    // 暗色外观。应用里跟随系统设置（注册表 AppsUseLightTheme），截图时由调用方指定。
    in-out property <bool> dark: false;
    // 窗口已设 Mica 背景：根窗口要透明，系统材质才透得出来。Win10 没有 Mica，保持纯色。
    in-out property <bool> mica: false;
    // 窗口底色：Win11 设置应用的浅灰与深灰。
    out property <brush> window-background: mica ? transparent : (dark ? #202020 : #f3f3f3);
    // 设置卡片的底色，比窗口底色略亮（浅色）或略亮一档（暗色）。
    out property <brush> card: dark ? #2b2b2b : #fbfbfb;
    // 卡片的细边框，让卡片在 Mica 上也有轮廓。
    out property <brush> card-border: dark ? #1d1d1d : #e5e5e5;
    // 导航项选中与悬停时的半透明底色。
    out property <brush> nav-selected: dark ? #ffffff0f : #0000000a;
    out property <brush> nav-hover: dark ? #ffffff0a : #00000006;
    // 强调色：Win11 默认的蓝色。应用里改从系统读（UISettings 的 Accent），这里是默认值。
    out property <brush> accent: dark ? #60cdff : #005fb8;
    // 主文字与次要文字（说明、数值）。
    out property <brush> text: dark ? #ffffff : #1b1b1b;
    out property <brush> text-secondary: dark ? #cfcfcf : #5f5f5f;
    // 需要用户留意的提示（设置不对、操作失败），取 Win11 的「注意」色。
    out property <brush> caution: dark ? #fce100 : #9d5d00;
    // 分隔线与色块的描边。
    out property <brush> divider: dark ? #ffffff14 : #0000000f;
    // 预览区的底色，衬托缩略图。
    out property <brush> thumbnail-backdrop: dark ? #1a1a1a : #e9e9e9;
}
