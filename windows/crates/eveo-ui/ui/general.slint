//
// 「通用」页，对应 macOS 的 GeneralPage 及其「更新」「诊断」两组：界面语言、自动检查与自动安装更新、详细日志与日志位置。
// 这些设置在配置的 general 里，对全部配置方案生效。
// macOS 的「在 Dock 中显示图标」在 Windows 上没有对应的东西（托盘程序本来就不占任务栏），这一页不出现。
//
// 与「预览与布局」页的约定相同：控件的 toggled、selected 只在用户操作时触发，触发后 Rust 读回整页组成新配置；
// Rust 用 set_* 写值不会触发它们，不会形成循环。
// 界面语言立即生效。更新一组（M7c3）：两个开关、当前版本、上次检查的时刻、一行状态与「立即检查」按钮；
// 版本、时刻与状态由应用层按更新状态机算好写进来，按钮交回应用。更新功能停用的构建（本机编译、版本号解析不了）
// 按钮不可用，状态写「这个构建不能使用更新功能」。
// 诊断一组：详细日志、日志位置与「报告问题…」（M7）。
// 「登录 Windows 时启动」（Windows 独有）：开关的状态来自注册表，不在配置里；用户拨动时交回应用写注册表，
// 写完应用再按注册表的实际状态写回开关。被任务管理器禁用或写入失败时，说明换成对应的一句话。
// 「游戏帧率」一组（Windows 独有）：开关与帧数在配置的 general.frameCap，改了照常读回整页；应用在后台线程里写
// NVIDIA 驱动，结果（检测中、不是 NVIDIA、已设好、要管理员权限、失败）写回说明。不是 NVIDIA 时整组置灰。

import { Button, ComboBox, SpinBox, Switch } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Footnote, Notice, PageHeader, RowGap, SectionHeader, SettingRow } from "components.slint";
import { DiagnosticsText, SettingsText, UpdateText } from "generated/l10n.slint";

// 本页的数据。字段对应配置的 general。
export global GeneralModel {
    // 界面语言：下标同 LanguagePreference 的顺序（English、中文……Español、跟随系统）。
    in-out property <int> language: 8;
    // general.checkForUpdates。
    in-out property <bool> check-updates: true;
    // general.autoInstallUpdates。
    in-out property <bool> auto-install: true;
    // general.logLevel 是 debug 时为真。
    in-out property <bool> verbose-log;
    // 日志文件夹的完整路径。
    in property <string> log-path;
    // 用户改了某个值：Rust 读回整页。
    callback edited();
    // 在资源管理器里显示日志文件夹。
    callback reveal-logs();
    // 打开问题报告窗口。
    callback report-problem();
    // 当前版本（构建标签）。
    in property <string> update-version;
    // 上次检查的时刻（本地时间），从没检查过时是「从未检查」。
    in property <string> update-last-checked;
    // 一行状态：检查中、已是最新、有新版本、已下载、被限流、不能使用更新功能；空串表示不显示。
    in property <string> update-status;
    // 「立即检查」能否点（更新功能停用或正在下载安装时不能）。
    in property <bool> update-can-check: true;
    // 「立即检查」。
    callback check-updates-now();
    // 开机启动是否开着（注册表里登记了且没被任务管理器禁用）。
    in-out property <bool> launch-at-login;
    // 开机启动的说明：空串时显示默认说明，否则显示这句（被系统禁用、改不了）。
    in property <string> launch-at-login-note;
    // 用户拨动了开机启动的开关，参数是想要的新状态。
    callback launch-at-login-toggled(bool);
    // general.frameCap.enabled。
    in-out property <bool> frame-cap-enabled;
    // general.frameCap.fps，范围同配置校验（10～1000）。
    in-out property <int> frame-cap-fps: 60;
    // 能不能拨开关：检测中与没有支持限帧的显卡驱动时为假。
    in property <bool> frame-cap-available;
    // 开关下方的说明（按状态与显卡厂商拼好）：空串时显示 NVIDIA 的默认说明（第一次检测完成之前）。
    in property <string> frame-cap-note;
    // 开关下方的红字警告：AMD 只能全局限帧，会影响所有游戏；其他厂商为空串。
    in property <string> frame-cap-warning;
    // 是否显示「AMD、Intel 尚未实测，欢迎反馈」的脚注。
    in property <bool> frame-cap-untested;
}

// 「通用」页。
export component GeneralPage inherits VerticalLayout {
    alignment: start;
    PageHeader {
        title: SettingsText.page-general;
        subtitle: SettingsText.general-subtitle;
    }

    // 语言：前 8 项用各语言的自称，不随界面语言变化，选错了也认得出自己的语言；最后一项随界面语言。
    SettingRow {
        title: SettingsText.interface-language;
        ComboBox {
            model: ["English", "中文", "Русский", "日本語", "한국어", "Français", "Deutsch", "Español", SettingsText.follow-system];
            current-index <=> GeneralModel.language;
            // 宽度放得下最长的自称（Français、Español）与「跟随系统」。
            width: 160px;
            selected(v) => {
                GeneralModel.edited();
            }
        }
    }
    Footnote {
        text: SettingsText.machine-translation-note;
    }

    // 开机启动：与语言一样对整个应用生效，放在更新一组之前。
    // 上面的脚注属于语言卡片；这里多留 12 像素，让脚注明显跟着上面的卡片，不像夹在两张卡片之间。
    Rectangle { height: 12px; }
    SettingRow {
        title: SettingsText.launch-at-login;
        description: GeneralModel.launch-at-login-note != "" ? GeneralModel.launch-at-login-note : SettingsText.launch-at-login-help;
        Switch {
            checked <=> GeneralModel.launch-at-login;
            toggled => {
                GeneralModel.launch-at-login-toggled(self.checked);
            }
        }
    }

    // 游戏帧率：放在更新一组之前，和开机启动一样是对整台电脑生效的设置。
    SectionHeader { text: SettingsText.frame-cap-section; }
    SettingRow {
        title: SettingsText.frame-cap-toggle;
        description: GeneralModel.frame-cap-note != "" ? GeneralModel.frame-cap-note : SettingsText.frame-cap-help;
        enabled: GeneralModel.frame-cap-available;
        Switch {
            checked <=> GeneralModel.frame-cap-enabled;
            enabled: GeneralModel.frame-cap-available;
            toggled => {
                GeneralModel.edited();
            }
        }
    }
    // AMD：开关下方用红字讲明会影响所有游戏（开关照样可以拨，用户知情后自己决定）。
    Notice {
        text: GeneralModel.frame-cap-warning;
        danger: true;
    }
    RowGap { }
    // 帧数只在开关打开时可改；关着时置灰，值照样保留。
    SettingRow {
        title: SettingsText.frame-cap-fps;
        enabled: GeneralModel.frame-cap-available && GeneralModel.frame-cap-enabled;
        SpinBox {
            value <=> GeneralModel.frame-cap-fps;
            minimum: 10;
            maximum: 1000;
            width: 120px;
            enabled: GeneralModel.frame-cap-available && GeneralModel.frame-cap-enabled;
            edited(v) => {
                GeneralModel.edited();
            }
        }
    }
    Footnote {
        text: SettingsText.frame-cap-note;
    }
    if GeneralModel.frame-cap-untested: Footnote {
        text: SettingsText.frame-cap-untested;
    }

    SectionHeader { text: UpdateText.section-header; }
    SettingRow {
        title: UpdateText.auto-check-toggle;
        description: UpdateText.auto-check-help;
        Switch {
            checked <=> GeneralModel.check-updates;
            toggled => {
                GeneralModel.edited();
            }
        }
    }
    RowGap { }
    // 自动安装依附于自动检查：检查关着时置灰，值照样保留。
    SettingRow {
        title: UpdateText.auto-install-toggle;
        description: UpdateText.auto-install-help;
        enabled: GeneralModel.check-updates;
        Switch {
            checked <=> GeneralModel.auto-install;
            enabled: GeneralModel.check-updates;
            toggled => {
                GeneralModel.edited();
            }
        }
    }
    RowGap { }
    SettingRow {
        title: UpdateText.current-version-label;
        Text {
            text: GeneralModel.update-version;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }
    }
    RowGap { }
    // 上次检查与「立即检查」放在一行：按钮就在时刻旁边，点完能看到时刻变化。
    SettingRow {
        title: UpdateText.last-checked-label;
        description: GeneralModel.update-status;
        HorizontalLayout {
            spacing: 12px;
            alignment: end;
            Text {
                text: GeneralModel.update-last-checked;
                color: Theme.text-secondary;
                vertical-alignment: center;
            }
            Button {
                text: UpdateText.check-now-button;
                enabled: GeneralModel.update-can-check;
                clicked => {
                    GeneralModel.check-updates-now();
                }
            }
        }
    }

    SectionHeader { text: DiagnosticsText.section-header; }
    SettingRow {
        title: DiagnosticsText.verbose-logging-toggle;
        description: DiagnosticsText.verbose-logging-help;
        Switch {
            checked <=> GeneralModel.verbose-log;
            toggled => {
                GeneralModel.edited();
            }
        }
    }
    RowGap { }
    // 日志的位置：%LOCALAPPDATA% 下的 EVE-O Preview\logs。
    SettingRow {
        title: DiagnosticsText.log-location-label;
        description: GeneralModel.log-path;
        Button {
            text: DiagnosticsText.show-logs-button;
            clicked => {
                GeneralModel.reveal-logs();
            }
        }
    }
    // 报告问题：打开问题报告窗口（手动情境），与托盘菜单的同名项相同。按钮单独一行，靠左。
    HorizontalLayout {
        alignment: start;
        padding-top: 12px;
        Button {
            text: DiagnosticsText.report-button;
            clicked => {
                GeneralModel.report-problem();
            }
        }
    }
    // 页底留白，滚到底时最后一行不贴着窗口边。
    Rectangle { height: 24px; }
}
