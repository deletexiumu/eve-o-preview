//
// 「预警」页，对应 macOS 的 IntelPage（docs/macos/design-intel-translate.md 第 10 节）。依次是
// 总开关与状态、频道、参考星系、显示（保留最近、最多计算、高亮距离、显示原文）、人名核对、浮窗、页尾说明。
// 设置在当前配置方案的 intel 里。
//
// 状态行显示聊天日志的跟踪状态，与 macOS 的 intelStatusText 相同。
// 「我的位置」每个在线角色一行：位置文字、星系输入框（回车提交）与「清除」；查不到星系时行下提示。
// 手动设置的位置存进 state.json，重启后还在。参考星系查不到时同样提示。人名核对下面是状态与缓存条数，
// 页尾是星图数据的版本。这些运行时的状态由应用层整组填入（Rust 侧的 IntelView），按钮经回调交给应用。
// 与其他页的约定相同：控件只在用户操作时触发 edited，Rust 读回整页；频道的增删是单独的回调。

import { Button, LineEdit, SpinBox, Switch } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Footnote, Notice, PageHeader, RowGap, SectionHeader, SettingRow, ValueLabel } from "components.slint";
import { ChannelListSection, OverlaySection } from "chat.slint";
import { IntelText, SettingsText } from "generated/l10n.slint";

// 「我的位置」的一行。
export struct IntelLocationRow {
    // 角色名。
    name: string,
    // 位置文字：「星系（来源，多久以前）」或「未知」。
    text: string,
    // 有没有位置记录（「清除」只在有记录时可点）。
    has-location: bool,
    // 上次输入的星系名查不到（行下提示，输入框保留输入的文字）。
    not-found: bool,
    // 设置成功的次数：每变一次清空这一行的输入框。
    cleared: int,
}

// 本页的数据。
export global IntelModel {
    // intel.enabled。
    in-out property <bool> enabled;
    // 聊天日志的状态文字（未启用、监视中、找不到目录、没有权限），随跟踪服务的消息刷新。
    in property <string> status-text;
    // intel.channels 显示的名字。
    in property <[string]> channels;
    // 频道已满 16 项。
    in property <bool> channels-full;
    // intel.referenceSystem；空串表示没有。
    in-out property <string> reference-system;
    // intel.windowMinutes，5～120，步长 5。
    in-out property <int> window-minutes: 30;
    // intel.maxJumps，1～30。
    in-out property <int> max-jumps: 15;
    // intel.alertJumps，0～30；0 表示不高亮。
    in-out property <int> alert-jumps: 5;
    // intel.showOriginal。
    in-out property <bool> show-original: true;
    // intel.resolvePilotNames。
    in-out property <bool> resolve-pilots: true;
    // intel.overlay 的显示范围、不透明度、字号，与是否保存过位置。
    in-out property <int> overlay-visibility;
    in-out property <float> overlay-opacity: 0.75;
    in-out property <float> overlay-font-size: 12;
    in property <bool> overlay-has-frame;
    // 运行时的状态（应用层整组填入）：在线角色的位置；没有在线角色时为空。
    in property <[IntelLocationRow]> locations;
    // 参考星系填了却查不到。
    in property <bool> reference-not-found;
    // 人名核对的状态文字；功能关着时为空。
    in property <string> pilot-status;
    // 人名缓存的条数文字；缓存文件还没读完时为空（「清空人名缓存」此时也不可点）。
    in property <string> pilot-cache;
    // 星图数据一行的文字。
    in property <string> static-data;
    // 用户改了某个值：Rust 读回整页。
    callback edited();
    // 手动设置某个角色（名字）的位置（星系名）；「清除」某个角色的位置；「清空人名缓存」。
    callback set-location(string, string);
    callback clear-location(string);
    callback clear-pilot-cache();
    // 移除第几个频道。
    callback remove-channel(int);
    // 按名称添加频道。
    callback add-channel(string);
    // 「恢复默认位置」。
    callback reset-overlay-frame();
}

// 「预警」页。
export component IntelPage inherits VerticalLayout {
    alignment: start;
    PageHeader {
        title: SettingsText.page-intel;
        subtitle: IntelText.page-subtitle;
    }

    // 第 1 组：总开关与状态。开关在配置方案里，不同方案可以分别开关。
    // 打开后才读聊天日志：读日志目录的时机与 macOS 相同，用户明确打开功能后才开始。
    SettingRow {
        title: IntelText.enable-toggle;
        Switch {
            checked <=> IntelModel.enabled;
            toggled => {
                IntelModel.edited();
            }
        }
    }
    RowGap { }
    // 状态文字含日志目录的路径，放在标题下面占满整行宽度，长路径不在右侧窄栏里折成几行。
    SettingRow {
        title: IntelText.status-label;
        description: IntelModel.status-text;
    }
    // EVE 默认不把聊天写进文件，这句提醒用户去游戏设置里打开。
    Footnote { text: SettingsText.chat-log-help; }

    // 第 2 组：预警频道（不列内置频道：预警只看玩家建的情报频道）。
    ChannelListSection {
        channels: IntelModel.channels;
        full: IntelModel.channels-full;
        show-built-ins: false;
        help: IntelText.channels-help;
        remove(index) => { IntelModel.remove-channel(index); }
        add-name(text) => { IntelModel.add-channel(text); }
    }

    // 第 3 组：我的位置与参考星系。位置取自游戏日志与本地频道；都没有时在这里手动填，不知道时跳数从参考星系算。
    SectionHeader { text: IntelText.location-header; }
    if IntelModel.locations.length == 0: SettingRow {
        title: IntelText.no-online-characters;
    }
    for row in IntelModel.locations: VerticalLayout {
        // 一个角色一张卡片：名字与位置文字在左，输入框与「清除」在右。
        SettingRow {
            title: row.name;
            description: row.text;
            LineEdit {
                // 应用在设置成功后把 cleared 加一，这里随之清空；查不到时保留文字，用户能看到输错了什么。
                property <int> cleared: row.cleared;
                changed cleared => { self.text = ""; }
                placeholder-text: IntelText.system-placeholder;
                width: 220px;
                accepted(text) => {
                    if text != "" {
                        IntelModel.set-location(row.name, text);
                    }
                }
            }
            Button {
                text: IntelText.clear-location;
                enabled: row.has-location;
                clicked => { IntelModel.clear-location(row.name); }
            }
        }
        Notice { text: row.not-found ? IntelText.system-not-found : ""; }
        RowGap { }
    }
    Footnote { text: IntelText.location-help; }
    RowGap { }
    SettingRow {
        title: IntelText.reference-system;
        description: IntelText.reference-system-help;
        // 回车或离开输入框时提交：输入到一半的名字不写进配置。
        LineEdit {
            text <=> IntelModel.reference-system;
            placeholder-text: IntelText.system-placeholder;
            width: 220px;
            accepted(text) => {
                IntelModel.edited();
            }
            changed has-focus => {
                if !self.has-focus {
                    IntelModel.edited();
                }
            }
        }
    }
    Notice { text: IntelModel.reference-not-found ? IntelText.system-not-found : ""; }

    // 第 4 组：显示。数字框右边是带单位的数值（单位随数量变化，例如俄语的复数）。
    SectionHeader { text: IntelText.display-header; }
    SettingRow {
        title: IntelText.window-minutes;
        // 步长 5 分钟：精确到分钟没有意义，步长大一点按几下就能到。
        SpinBox {
            value <=> IntelModel.window-minutes;
            minimum: 5;
            maximum: 120;
            step-size: 5;
            width: 120px;
            edited(v) => { IntelModel.edited(); }
        }
        ValueLabel {
            text: IntelText.minutes(IntelModel.window-minutes);
            width: 80px;
        }
    }
    RowGap { }
    SettingRow {
        title: IntelText.max-jumps;
        // 超过这个跳数显示「超过 N 跳」，不再往外找路径。
        SpinBox {
            value <=> IntelModel.max-jumps;
            minimum: 1;
            maximum: 30;
            width: 120px;
            edited(v) => { IntelModel.edited(); }
        }
        ValueLabel {
            text: IntelText.jumps-unit(IntelModel.max-jumps);
            width: 80px;
        }
    }
    RowGap { }
    SettingRow {
        title: IntelText.alert-jumps;
        description: IntelText.alert-jumps-help;
        SpinBox {
            value <=> IntelModel.alert-jumps;
            minimum: 0;
            maximum: 30;
            width: 120px;
            edited(v) => { IntelModel.edited(); }
        }
        ValueLabel {
            text: IntelText.jumps-unit(IntelModel.alert-jumps);
            width: 80px;
        }
    }
    RowGap { }
    SettingRow {
        title: IntelText.show-original;
        // 每条下面附原始消息，人名与数量推断错了时能对照。
        Switch {
            checked <=> IntelModel.show-original;
            toggled => {
                IntelModel.edited();
            }
        }
    }

    // 第 5 组：人名核对（向 CCP 的 ESI 查几个连在一起的人名各是谁）。
    SectionHeader { text: IntelText.pilot-lookup-label; }
    SettingRow {
        title: IntelText.resolve-pilots-toggle;
        description: IntelText.resolve-pilots-help;
        Switch {
            checked <=> IntelModel.resolve-pilots;
            toggled => {
                IntelModel.edited();
            }
        }
    }
    // 开关打开时显示核对的状态（就绪、核对中、等待重试）。
    if IntelModel.resolve-pilots && IntelModel.pilot-status != "": VerticalLayout {
        RowGap { }
        SettingRow {
            title: IntelText.pilot-lookup-label;
            ValueLabel {
                text: IntelModel.pilot-status;
                width: 340px;
                wrap: word-wrap;
            }
        }
    }
    RowGap { }
    // 人名缓存：查过的人名存在本机，同一个名字不再联网查。
    SettingRow {
        title: IntelModel.pilot-cache;
        Button {
            text: IntelText.clear-pilot-cache;
            enabled: IntelModel.pilot-cache != "";
            clicked => { IntelModel.clear-pilot-cache(); }
        }
    }

    // 第 6 组：浮窗。外观改动立即生效，与缩略图的滑块一样。
    OverlaySection {
        visibility <=> IntelModel.overlay-visibility;
        background-opacity <=> IntelModel.overlay-opacity;
        text-size <=> IntelModel.overlay-font-size;
        has-frame: IntelModel.overlay-has-frame;
        edited => { IntelModel.edited(); }
        reset-frame => { IntelModel.reset-overlay-frame(); }
    }
    // 页尾：星图数据的版本（缺失时说明不能识别星系和舰船）与说明文字。
    RowGap { }
    SettingRow {
        title: IntelText.static-data-label;
        ValueLabel {
            text: IntelModel.static-data;
            width: 340px;
            wrap: word-wrap;
        }
    }
    Footnote { text: IntelText.footnote; }
    // 页底留白。
    Rectangle { height: 24px; }
}
