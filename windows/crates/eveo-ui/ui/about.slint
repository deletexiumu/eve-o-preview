// SPDX-License-Identifier: GPL-3.0-or-later
//
// 「关于」页，对应 macOS 的 AboutPage（架构文档 7.4 节）：版本、上游项目与许可证（GPL-3.0）、
// 「只切换焦点、不广播输入」等说明与 EVE 的商标声明。GPL-3.0 要求标明来源与许可证，这两条链接不能去掉。
// 链接由 Rust 用默认浏览器打开；页上只放固定的地址，不接受别处传来的地址。

import { Theme } from "theme.slint";
import { Footnote, PageHeader, SectionHeader } from "components.slint";
import { SettingsText } from "generated/l10n.slint";

// 本页的数据。
export global AboutModel {
    // 版本号，由 Rust 填。
    in property <string> version;
    // 打开一个链接。
    callback open-url(string);
}

// 一张卡片里的一段说明文字，可换行。
component Paragraph inherits Rectangle {
    // 文字。
    in property <string> text;
    background: Theme.card;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.card-border;
    VerticalLayout {
        padding: 14px;
        padding-left: 18px;
        padding-right: 18px;
        Text {
            text: root.text;
            color: Theme.text;
            wrap: word-wrap;
        }
    }
}

// 链接：强调色文字，悬停时手形光标并加深。
component Link inherits Text {
    // 显示的文字。
    in property <string> label;
    // 地址。
    in property <string> url;
    text: label;
    color: touch.has-hover ? Theme.text : Theme.accent;
    touch := TouchArea {
        // 手形光标提示可点；整段文字都是点击区域。
        mouse-cursor: pointer;
        clicked => {
            AboutModel.open-url(root.url);
        }
    }
}

// 说明加一条链接的卡片：上游项目与许可证各一张。
component LinkCard inherits Rectangle {
    // 说明文字。
    in property <string> text;
    // 链接文字。
    in property <string> label;
    // 链接地址。
    in property <string> url;
    background: Theme.card;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.card-border;
    VerticalLayout {
        padding: 14px;
        padding-left: 18px;
        padding-right: 18px;
        spacing: 6px;
        Text {
            text: root.text;
            color: Theme.text;
            wrap: word-wrap;
        }
        // 链接靠左，不拉满整行（整行可点会误触）。
        HorizontalLayout {
            alignment: start;
            Link {
                label: root.label;
                url: root.url;
            }
        }
    }
}

// 「关于」页。
export component AboutPage inherits VerticalLayout {
    alignment: start;
    PageHeader {
        title: "EVE-O Preview";
        subtitle: SettingsText.about-subtitle;
    }

    // 版本与一句话介绍。
    Rectangle {
        background: Theme.card;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.card-border;
        VerticalLayout {
            padding: 14px;
            padding-left: 18px;
            padding-right: 18px;
            spacing: 6px;
            HorizontalLayout {
                Text {
                    // 左边是名字，右边是版本号，与设置行的排法一致。
                    text: SettingsText.version;
                    color: Theme.text;
                    horizontal-stretch: 1;
                }
                Text {
                    text: AboutModel.version;
                    color: Theme.text-secondary;
                }
            }
            Text {
                // 一句话介绍，次要文字色。
                text: SettingsText.about-summary;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
        }
    }

    // 上游项目与许可证：GPL-3.0 要求标明来源与许可证。
    SectionHeader { text: SettingsText.upstream-header; }
    LinkCard {
        text: SettingsText.upstream-text;
        label: "EveOPlus/eve-o-preview";
        url: "https://github.com/EveOPlus/eve-o-preview";
    }
    Rectangle { height: 4px; }
    LinkCard {
        text: SettingsText.license-text;
        label: "GNU GPL v3.0";
        url: "https://www.gnu.org/licenses/gpl-3.0.html";
    }

    // 说明：只切换焦点、不广播输入（与上游的边界相同），只读日志，联网的范围。
    SectionHeader { text: SettingsText.disclaimer-header; }
    // 与上游的边界相同：不做输入广播（架构文档 R7）。
    Paragraph { text: SettingsText.focus-only-text; }
    Rectangle { height: 4px; }
    Paragraph { text: SettingsText.game-log-text; }
    Rectangle { height: 4px; }
    Paragraph { text: SettingsText.about-chat-logs-note; }
    Rectangle { height: 4px; }
    Paragraph { text: SettingsText.network-text; }
    // 商标声明用小字，放在最后。
    Footnote { text: SettingsText.eve-ip-text; }
    // 页底留白。
    Rectangle { height: 24px; }
}
