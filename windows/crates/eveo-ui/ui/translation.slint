//
// 「翻译」页，对应 macOS 的 TranslationPage（docs/macos/design-intel-translate.md 第 10 节）。依次是
// 总开关与状态、频道（可添加 4 个内置频道）、目标语言与显示、模型服务、浮窗、页尾的隐私与费用说明。
// 开关、频道、目标语言与浮窗在当前配置方案的 translation 里；模型服务在 general.translationEndpoint，对全部方案生效。
//
// 状态行在暂停或等待时用醒目的颜色并附「立即重试」；API Key 存进 Windows 凭据管理器，输入框是密文，保存后清空；
// 「测试」用当前设置发一次固定样例；译文缓存一行显示条数并可清空。这些运行时的状态由应用层整组填入（Rust 侧的
// TranslationView），按钮经回调交给应用。换服务预设时清掉自定义的地址与模型名（与 macOS 相同）；
// 输入框的提示是预设的默认值，留空就用它。

import { Button, ComboBox, LineEdit, Switch } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Footnote, Notice, PageHeader, RowGap, SectionHeader, SettingRow } from "components.slint";
import { ChannelListSection, OverlaySection } from "chat.slint";
import { SettingsText, TranslationText } from "generated/l10n.slint";

// 本页的数据。
export global TranslationModel {
    // translation.enabled。
    in-out property <bool> enabled;
    // translation.channels 显示的名字。
    in property <[string]> channels;
    // 频道已满 16 项。
    in property <bool> channels-full;
    // 4 个内置频道是否已选。
    in property <[bool]> built-in-selected: [false, false, false, false];
    // 目标语言下拉的选项：第一项「跟随界面语言」，其余是 8 种语言的自称。
    in property <[string]> target-names;
    // translation.targetLanguage 在上面选项里的下标（TranslationTarget 的声明顺序）。
    in-out property <int> target: 0;
    // translation.showOriginal 与 foreignOnly。
    in-out property <bool> show-original: true;
    in-out property <bool> foreign-only;
    // 服务预设的名字与选中的下标（TranslationProviderId 的声明顺序）。
    in property <[string]> provider-names;
    in-out property <int> provider: 0;
    // 接口地址与模型名；空串表示用预设值，预设值作为输入框的提示。
    in-out property <string> base-url;
    in-out property <string> model;
    in property <string> base-url-placeholder;
    in property <string> model-placeholder;
    // 这个预设是否用 Key；不用时 Key 一行只说明不需要。
    in property <bool> uses-key: true;
    // 运行时的状态（应用层整组填入）：状态行的文字与是否需要留意（暂停或等待）。
    in property <string> status-text;
    in property <bool> needs-attention;
    // 聊天日志的错误（找不到目录、没有权限）；为空表示没有。
    in property <string> chat-log-problem;
    // 接口设置不能用的原因；为空表示能用。
    in property <string> endpoint-issue;
    // Key 输入框的草稿（密文显示）；保存成功后应用清空它。
    in-out property <string> key-draft;
    // 当前预设的 Key 是否已在凭据管理器里；是否是自定义接口（Key 可不填）。
    in property <bool> key-stored;
    in property <bool> key-optional;
    // 保存或删除 Key 失败的说明；为空表示没有。
    in property <string> key-error;
    // 「测试」在等答复；测试结果的文字与是否成功。
    in property <bool> testing;
    in property <string> test-result;
    in property <bool> test-succeeded;
    // 译文缓存的条数文字，与是否为空（为空时「清空缓存」不可点）。
    in property <string> cache-text;
    in property <bool> cache-empty: true;
    // translation.overlay 的显示范围、不透明度、字号，与是否保存过位置。
    in-out property <int> overlay-visibility;
    in-out property <float> overlay-opacity: 0.75;
    in-out property <float> overlay-font-size: 12;
    in property <bool> overlay-has-frame;
    // 用户改了某个值：Rust 读回整页。
    callback edited();
    // 移除第几个频道。
    callback remove-channel(int);
    // 按名称添加频道。
    callback add-channel(string);
    // 「从日志添加」下拉框的各项（第一项是提示文字）；两页的内容由应用分别填（已选的频道不同）。
    in property <[string]> discovered;
    // 添加「从日志添加」里的第几个频道（不含提示文字）。
    callback add-discovered(int);
    // 重新扫描日志目录（切到本页、点「刷新」时）。
    callback refresh-discovered();
    // 添加第几个内置频道（本地、军团、联盟、舰队）。
    callback add-built-in(int);
    // 「恢复默认位置」。
    callback reset-overlay-frame();
    // 「保存」Key（参数是草稿）、「删除 Key」、「立即重试」、「测试」、「清空缓存」。
    callback save-key(string);
    callback delete-key();
    callback retry();
    callback test();
    callback clear-cache();
}

// 「翻译」页。
export component TranslationPage inherits VerticalLayout {
    alignment: start;
    PageHeader {
        title: SettingsText.page-translation;
        subtitle: TranslationText.page-subtitle;
    }

    // 第 1 组：总开关与状态。
    // 打开后才读聊天日志、才把消息发给模型服务。
    SettingRow {
        title: TranslationText.enable-toggle;
        Switch {
            checked <=> TranslationModel.enabled;
            toggled => {
                TranslationModel.edited();
            }
        }
    }
    RowGap { }
    SettingRow {
        title: TranslationText.status-label;
        Text {
            text: TranslationModel.status-text;
            // 暂停或等待时用「注意」色，提醒用户看原因。
            color: TranslationModel.needs-attention ? Theme.caution : Theme.text-secondary;
            vertical-alignment: center;
            horizontal-alignment: right;
            wrap: word-wrap;
            // 状态文字较长（附失败原因），限制宽度并换行。
            max-width: 340px;
        }
        if TranslationModel.needs-attention: Button {
            text: TranslationText.retry-now;
            clicked => { TranslationModel.retry(); }
        }
    }
    Notice { text: TranslationModel.chat-log-problem; }
    Footnote { text: SettingsText.chat-log-help; }

    // 第 2 组：翻译频道，可直接添加内置频道（本地频道最常用）。
    ChannelListSection {
        channels: TranslationModel.channels;
        full: TranslationModel.channels-full;
        show-built-ins: true;
        built-in-selected: TranslationModel.built-in-selected;
        help: TranslationText.channels-help;
        remove(index) => { TranslationModel.remove-channel(index); }
        add-name(text) => { TranslationModel.add-channel(text); }
        discovered: TranslationModel.discovered;
        add-discovered(index) => { TranslationModel.add-discovered(index); }
        refresh-discovered => { TranslationModel.refresh-discovered(); }
        add-built-in(index) => { TranslationModel.add-built-in(index); }
    }

    // 第 3 组：目标语言与显示。
    SectionHeader { text: TranslationText.target-header; }
    SettingRow {
        title: TranslationText.target-language;
        // 第一项「跟随界面语言」，其余是语言的自称，选项文字不随界面语言变。
        ComboBox {
            model: TranslationModel.target-names;
            current-index <=> TranslationModel.target;
            // 「跟随界面语言」在德语、法语里较长，下拉框放宽一些。
            width: 260px;
            selected(v) => { TranslationModel.edited(); }
        }
    }
    RowGap { }
    SettingRow {
        title: TranslationText.show-original;
        Switch {
            checked <=> TranslationModel.show-original;
            toggled => {
                TranslationModel.edited();
            }
        }
    }
    RowGap { }
    SettingRow {
        title: TranslationText.foreign-only;
        // 打开后与目标语言相同的消息不显示，浮窗里只剩外语消息的译文。
        Switch {
            checked <=> TranslationModel.foreign-only;
            toggled => {
                TranslationModel.edited();
            }
        }
    }

    // 第 4 组：模型服务。地址与模型名在回车或离开输入框时提交。
    SectionHeader { text: TranslationText.model-header; }
    SettingRow {
        title: TranslationText.provider;
        // 服务名不翻译；最后一项「其他」是界面文字。
        ComboBox {
            model: TranslationModel.provider-names;
            current-index <=> TranslationModel.provider;
            width: 260px;
            selected(v) => { TranslationModel.edited(); }
        }
    }
    RowGap { }
    SettingRow {
        title: TranslationText.base-url;
        LineEdit {
            text <=> TranslationModel.base-url;
            placeholder-text: TranslationModel.base-url-placeholder;
            // 地址通常较长。
            width: 340px;
            accepted(text) => {
                TranslationModel.edited();
            }
            changed has-focus => {
                if !self.has-focus {
                    TranslationModel.edited();
                }
            }
        }
    }
    // 地址不能用时（公网 http、格式不对等）在地址下面说明原因。
    Notice { text: TranslationModel.endpoint-issue; }
    RowGap { }
    SettingRow {
        title: TranslationText.model;
        LineEdit {
            text <=> TranslationModel.model;
            placeholder-text: TranslationModel.model-placeholder;
            width: 340px;
            accepted(text) => {
                TranslationModel.edited();
            }
            changed has-focus => {
                if !self.has-focus {
                    TranslationModel.edited();
                }
            }
        }
    }
    RowGap { }
    // Ollama 这类本机服务不用 Key，只显示一句说明。
    if !TranslationModel.uses-key: SettingRow {
        title: TranslationText.api-key;
        Text {
            text: TranslationText.key-not-required;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }
    }
    // 要 Key 的服务：密文输入框与「保存」「删除 Key」。Key 存进 Windows 凭据管理器，不进配置文件。
    if TranslationModel.uses-key: SettingRow {
        title: TranslationText.api-key;
        // 已保存时说明存在哪里；自定义接口另说明 Key 可不填。
        description: TranslationModel.key-stored ? TranslationText.api-key-stored : (TranslationModel.key-optional ? TranslationText.key-optional : "");
        LineEdit {
            text <=> TranslationModel.key-draft;
            input-type: password;
            placeholder-text: TranslationText.api-key-placeholder;
            width: 200px;
            accepted(text) => { TranslationModel.save-key(text); }
        }
        Button {
            text: TranslationText.save-key;
            enabled: TranslationModel.key-draft != "";
            clicked => { TranslationModel.save-key(TranslationModel.key-draft); }
        }
        Button {
            text: TranslationText.delete-key;
            enabled: TranslationModel.key-stored;
            clicked => { TranslationModel.delete-key(); }
        }
    }
    Notice { text: TranslationModel.key-error; }
    RowGap { }
    // 「测试」：用当前的设置与 Key 发一次固定样例，结果显示在下面。
    SettingRow {
        title: TranslationText.test;
        Button {
            text: TranslationModel.testing ? TranslationText.testing : TranslationText.test;
            enabled: !TranslationModel.testing;
            clicked => { TranslationModel.test(); }
        }
    }
    Notice {
        text: TranslationModel.test-result;
        calm: TranslationModel.test-succeeded;
    }

    // 第 5 组：浮窗。
    OverlaySection {
        visibility <=> TranslationModel.overlay-visibility;
        background-opacity <=> TranslationModel.overlay-opacity;
        text-size <=> TranslationModel.overlay-font-size;
        has-frame: TranslationModel.overlay-has-frame;
        edited => { TranslationModel.edited(); }
        reset-frame => { TranslationModel.reset-overlay-frame(); }
    }
    // 第 6 组：译文缓存。已翻译过的句子不再花钱；清空后文件也变空。
    SectionHeader { text: TranslationText.cache-header; }
    SettingRow {
        title: TranslationModel.cache-text;
        Button {
            text: TranslationText.clear-cache;
            enabled: !TranslationModel.cache-empty;
            clicked => { TranslationModel.clear-cache(); }
        }
    }
    // 页尾：发给谁、花多少，两句说明。
    Footnote { text: TranslationText.privacy-note; }
    Footnote { text: TranslationText.cost-note; }
    // 页底留白。
    Rectangle { height: 24px; }
}
