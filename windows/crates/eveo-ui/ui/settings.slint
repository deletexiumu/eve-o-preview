//
// 设置窗口（架构文档 2.3 节）：仿 Windows 11 设置的布局，左侧导航、右侧分组卡片。
// 颜色跟随 Theme.dark 的明暗；Win11 上根窗口背景透明，由 Mica 透出来，纯色是降级用的。
// 各页的值放在各自的全局模型里（如 PreviewsModel、ClientsModel），由 Rust 的 bind 模块与配置互相转换。
// 还没做完的页显示「即将推出」，导航先占好位置。

import { LineEdit, Palette, ScrollView } from "std-widgets.slint";
import { Icons } from "icons.slint";
import { Theme } from "theme.slint";
import { NavItem, PageHeader } from "components.slint";
import { PreviewsModel, PreviewsPage } from "previews.slint";
import { CharacterRow, ClientsModel, ClientsPage } from "clients.slint";
import { CycleGroupData, HotkeyRow, HotkeySlotData, MemberRow, SwitchingModel, SwitchingPage } from "switching.slint";

export { CharacterRow, ClientsModel, CycleGroupData, HotkeyRow, HotkeySlotData, MemberRow, PreviewsModel, SwitchingModel }

// 还没做完的页：页标题加一句说明。导航项先全部列出，测试的人能看到完整的结构，
// 也不必在每次加页时改导航；页做好后把对应的 ComingSoonPage 换成真正的页面。
component ComingSoonPage inherits VerticalLayout {
    // 页名，与导航项相同。
    in property <string> title;
    alignment: start;
    PageHeader {
        title: root.title;
        subtitle: "这一页还在做，稍后的测试版会加上。";
    }
}

// 设置窗口。
export component SettingsWindow inherits Window {
    // 暗色外观，见 Theme.dark。
    in-out property <bool> dark <=> Theme.dark;
    // 已设 Mica 背景，见 Theme.mica。
    in-out property <bool> mica <=> Theme.mica;
    // 当前页：0 客户端，1 预览与布局，2 切换与热键，3 提醒，4 预警，5 翻译，6 配置方案，7 通用，8 关于。
    in-out property <int> page: 1;
    // 界面字体。Windows 上是 Segoe UI Variable，中日韩文字由系统字体回退补上（微软雅黑等）。
    in property <string> ui-font: "Segoe UI Variable Text";
    // 首次打开的大小；可以缩小到最小尺寸，内容区滚动。
    title: "EVE-O Preview 设置";
    preferred-width: 1040px;
    preferred-height: 760px;
    min-width: 760px;
    min-height: 520px;
    background: Theme.window-background;
    default-font-family: ui-font;
    default-font-size: 14px;

    // std-widgets 的控件按 Palette.color-scheme 选明暗配色，要与 Theme.dark 一致。
    init => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }
    // 运行中系统切换明暗时同步。
    changed dark => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    HorizontalLayout {
        // 左侧导航。宽度与 Win11 设置应用相近；顶部是应用名与查找框，「关于」沉到底部。
        VerticalLayout {
            width: 280px;
            padding: 12px;
            padding-top: 16px;
            spacing: 2px;
            // 应用名一行：图标加名字。
            HorizontalLayout {
                padding-left: 6px;
                padding-bottom: 16px;
                spacing: 12px;
                // 应用图标的占位：橙红渐变方块，正式图标在 M8 设计。
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    background: @linear-gradient(135deg, #f2a23c 0%, #c0392b 100%);
                    Text {
                        text: "EO";
                        color: #ffffff;
                        font-size: 12px;
                        font-weight: 700;
                    }
                }
                Text {
                    text: "EVE-O Preview";
                    color: Theme.text;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }
            // 查找框：按设置项的名字过滤（M5 实现），原型里只占位。
            LineEdit {
                placeholder-text: "查找设置";
            }
            Rectangle { height: 12px; }
            NavItem { icon: Icons.clients; text: "客户端"; selected: page == 0; clicked => { page = 0; } }
            NavItem { icon: Icons.previews; text: "预览与布局"; selected: page == 1; clicked => { page = 1; } }
            NavItem { icon: Icons.switching; text: "切换与热键"; selected: page == 2; clicked => { page = 2; } }
            NavItem { icon: Icons.alerts; text: "提醒"; selected: page == 3; clicked => { page = 3; } }
            NavItem { icon: Icons.intel; text: "预警"; selected: page == 4; clicked => { page = 4; } }
            NavItem { icon: Icons.translation; text: "翻译"; selected: page == 5; clicked => { page = 5; } }
            NavItem { icon: Icons.profiles; text: "配置方案"; selected: page == 6; clicked => { page = 6; } }
            NavItem { icon: Icons.general; text: "通用"; selected: page == 7; clicked => { page = 7; } }
            // 弹性空白，把「关于」推到底部。
            Rectangle { }
            NavItem { icon: Icons.about; text: "关于"; selected: page == 8; clicked => { page = 8; } }
        }
        // 右侧内容：可滚动；右边距比左边大一些，给滚动条留位置。
        ScrollView {
            // 内容区的边距与 Win11 设置相近。
            VerticalLayout {
                padding: 36px;
                padding-top: 28px;
                padding-right: 48px;
                // 按导航切换页面；条件元素只建当前页，其余页不占布局。
                // 页的数据在全局模型里，切走再切回来时控件重建，但值不丢，也不用重新从配置读。
                if page == 1: PreviewsPage { }
                if page == 0: ClientsPage { }
                if page == 2: SwitchingPage { }
                if page == 3: ComingSoonPage { title: "提醒"; }
                if page == 4: ComingSoonPage { title: "预警"; }
                if page == 5: ComingSoonPage { title: "翻译"; }
                if page == 6: ComingSoonPage { title: "配置方案"; }
                if page == 7: ComingSoonPage { title: "通用"; }
                if page == 8: ComingSoonPage { title: "关于"; }
            }
        }
    }
}
