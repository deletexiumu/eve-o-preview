// SPDX-License-Identifier: GPL-3.0-or-later
//
// 设置窗口（架构文档 2.3 节）：仿 Windows 11 设置的布局，左侧导航、右侧分组卡片。
// 颜色跟随 Theme.dark 的明暗；Win11 上根窗口背景透明，由 Mica 透出来，纯色是降级用的。
// 各页的值放在各自的全局模型里（如 PreviewsModel、ClientsModel），由 Rust 的 bind 模块与配置互相转换。
// 界面上的文字都取自 generated/l10n.slint 的全局（SettingsText 等），Rust 按界面语言填值。

import { LineEdit, Palette, ScrollView } from "std-widgets.slint";
import { Icons } from "icons.slint";
import { Theme } from "theme.slint";
import { NavItem, PageHeader } from "components.slint";
import { PreviewsModel, PreviewsPage } from "previews.slint";
import { CharacterRow, ClientsModel, ClientsPage } from "clients.slint";
import { CycleGroupData, HotkeyRow, HotkeySlotData, MemberRow, SwitchingModel, SwitchingPage } from "switching.slint";
import { ProfileRow, ProfilesModel, ProfilesPage } from "profiles.slint";
import { GeneralModel, GeneralPage } from "general.slint";
import { AboutModel, AboutPage } from "about.slint";
import { AlertsModel, AlertsPage } from "alerts.slint";
import { IntelLocationRow, IntelModel, IntelPage } from "intel.slint";
import { TranslationModel, TranslationPage } from "translation.slint";
import { EnvironmentModel, EnvironmentPage } from "environment.slint";
import { OverlayRowData, OverlayWindow } from "overlay.slint";
import { ProblemReportWindow, ReportFileRow, ReportModel } from "report.slint";
import { NotesBlock, UpdateModel, UpdateWindow } from "update.slint";
import { CombatText, DiagnosticsText, HotkeyText, IntelText, OverlayText, SettingsText, TranslationText, UpdateText } from "generated/l10n.slint";

// 浮窗是另一个窗口，与设置窗口一起编译，共用主题与字体的约定。
export { OverlayRowData, OverlayWindow }
// 问题报告窗口也是另一个窗口（M7b2）。
export { ProblemReportWindow, ReportFileRow, ReportModel }
// 软件更新窗口（M7c3）。
export { NotesBlock, UpdateModel, UpdateWindow }
export { AboutModel, AlertsModel, CharacterRow, ClientsModel, CycleGroupData, EnvironmentModel, GeneralModel, HotkeyRow, HotkeySlotData, IntelLocationRow, IntelModel, MemberRow, PreviewsModel, ProfileRow, ProfilesModel, SwitchingModel, TranslationModel }
// 界面文字的全局，由 Rust 的 l10n::apply 按界面语言填值。
export { CombatText, DiagnosticsText, HotkeyText, IntelText, OverlayText, SettingsText, TranslationText, UpdateText }

// 设置窗口。
export component SettingsWindow inherits Window {
    // 暗色外观，见 Theme.dark。
    in-out property <bool> dark <=> Theme.dark;
    // 已设 Mica 背景，见 Theme.mica。
    in-out property <bool> mica <=> Theme.mica;
    // 当前页：0 客户端，1 预览与布局，2 切换与热键，3 提醒，4 预警，5 翻译，6 配置方案，7 通用，8 关于，9 环境检查（导航里排在「通用」之后，编号放在最后，已有的编号不变）。
    in-out property <int> page: 1;
    // 切页时回到顶部：各页共用这一个滚动区，不重置的话新页会停在上一页滚到的位置（例如在长页滚到底再切过去，
    // 新页一打开就在下半截）。
    changed page => {
        content.viewport-y = 0;
    }
    // 界面字体。Windows 上是 Segoe UI Variable，中日韩文字由系统字体回退补上（微软雅黑等）。
    in property <string> ui-font: "Segoe UI Variable Text";
    // 首次打开的大小；可以缩小到最小尺寸，内容区滚动。
    title: SettingsText.window-title;
    // 标题栏与任务栏的图标：应用图标的头像版（shared/branding/make-icons.py 生成），小尺寸下认得出。
    icon: @image-url("images/app-icon.png");
    preferred-width: 1040px;
    preferred-height: 760px;
    min-width: 760px;
    min-height: 520px;
    background: Theme.window-background;
    default-font-family: ui-font;
    default-font-size: 14px;

    // std-widgets 的控件按 Palette.color-scheme 选明暗配色，要与 Theme.dark 一致。
    init => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }
    // 运行中系统切换明暗时同步。
    changed dark => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    HorizontalLayout {
        // 左侧导航。宽度与 Win11 设置应用相近；顶部是应用名与查找框，「关于」沉到底部。
        VerticalLayout {
            width: 280px;
            padding: 12px;
            padding-top: 16px;
            spacing: 2px;
            // 应用名一行：图标加名字。
            HorizontalLayout {
                padding-left: 6px;
                padding-bottom: 16px;
                spacing: 12px;
                // 应用图标：与标题栏同一张头像（64 像素，在高缩放比例下也清晰）。
                Image {
                    source: @image-url("images/app-icon.png");
                    width: 28px;
                    height: 28px;
                    image-fit: contain;
                }
                Text {
                    text: "EVE-O Preview";
                    color: Theme.text;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }
            // 查找框：按设置项的名字过滤（M5 实现），原型里只占位。
            LineEdit {
                placeholder-text: SettingsText.search-settings;
            }
            Rectangle { height: 12px; }
            NavItem { icon: Icons.clients; text: SettingsText.page-clients; selected: page == 0; clicked => { page = 0; } }
            NavItem { icon: Icons.previews; text: SettingsText.page-previews; selected: page == 1; clicked => { page = 1; } }
            NavItem { icon: Icons.switching; text: SettingsText.page-switching; selected: page == 2; clicked => { page = 2; } }
            NavItem { icon: Icons.alerts; text: SettingsText.page-alerts; selected: page == 3; clicked => { page = 3; } }
            NavItem { icon: Icons.intel; text: SettingsText.page-intel; selected: page == 4; clicked => { page = 4; } }
            NavItem { icon: Icons.translation; text: SettingsText.page-translation; selected: page == 5; clicked => { page = 5; } }
            NavItem { icon: Icons.profiles; text: SettingsText.page-profiles; selected: page == 6; clicked => { page = 6; } }
            NavItem { icon: Icons.general; text: SettingsText.page-general; selected: page == 7; clicked => { page = 7; } }
            NavItem { icon: Icons.environment; text: SettingsText.page-environment; selected: page == 9; clicked => { page = 9; } }
            // 弹性空白，把「关于」推到底部。
            Rectangle { }
            NavItem { icon: Icons.about; text: SettingsText.page-about; selected: page == 8; clicked => { page = 8; } }
        }
        // 右侧内容：可滚动；右边距比左边大一些，给滚动条留位置。
        content := ScrollView {
            // 内容区的边距与 Win11 设置相近。
            VerticalLayout {
                padding: 36px;
                padding-top: 28px;
                padding-right: 48px;
                // 按导航切换页面；条件元素只建当前页，其余页不占布局。
                // 页的数据在全局模型里，切走再切回来时控件重建，但值不丢，也不用重新从配置读。
                if page == 1: PreviewsPage { }
                if page == 0: ClientsPage { }
                if page == 2: SwitchingPage { }
                if page == 3: AlertsPage { }
                if page == 4: IntelPage { }
                if page == 5: TranslationPage { }
                if page == 6: ProfilesPage { }
                if page == 7: GeneralPage { }
                if page == 8: AboutPage { }
                if page == 9: EnvironmentPage { }
            }
        }
    }
}
