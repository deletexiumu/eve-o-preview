// SPDX-License-Identifier: GPL-3.0-or-later
//
// 「提醒」页，对应 macOS 的 AlertsPage（反馈文档 7.11 节）：角色被攻击时闪烁缩略图。依次是
// 总开关与状态、游戏日志目录、闪烁的外观（颜色、持续时间、样式）、触发条件（未命中也提醒、最小伤害）、「测试闪烁」。
// 战斗提醒的设置在当前配置方案的 combatAlert 里；日志目录在 general.eveLogDirectory，对全部方案生效。
//
// 状态行显示游戏日志跟踪服务的状态（未启用、监视中、找不到目录、没有权限），文字由 Rust 按当前语言拼好。
// macOS 用系统的文件夹选择框；这里先用输入框填路径（回车或离开输入框时提交），空着就是自动查找。
// 与「预览与布局」页的约定相同：控件只在用户操作时触发 edited，Rust 读回整页。

import { Button, ComboBox, LineEdit, Slider, SpinBox, Switch } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ColorField, Footnote, PageHeader, RowGap, SectionHeader, SettingRow, ValueLabel } from "components.slint";
import { CombatText, SettingsText } from "generated/l10n.slint";

// 本页的数据。
export global AlertsModel {
    // combatAlert.enabled。
    in-out property <bool> enabled;
    // general.eveLogDirectory；空串表示自动查找。
    in-out property <string> log-directory;
    // 自动查找时的位置，作为输入框的提示。
    in property <string> automatic-directory;
    // 游戏日志跟踪服务的状态文字。
    in property <string> status-text;
    // combatAlert.color 的输入框文字与样本。
    in-out property <string> color: "#FF3B30";
    in property <color> swatch: #ff3b30;
    // combatAlert.durationSeconds，1～10 秒，步长 0.5。
    in-out property <float> duration: 3;
    // combatAlert.style：0 边框，1 底色，2 两者。
    in-out property <int> style: 2;
    // combatAlert.includeMisses。
    in-out property <bool> include-misses: true;
    // combatAlert.minimumDamage，1～100,000。
    in-out property <int> minimum-damage: 1;
    // 用户改了某个值：Rust 读回整页。
    callback edited();
    // 「测试闪烁」。
    callback test-flash();
}

// 「提醒」页。
export component AlertsPage inherits VerticalLayout {
    alignment: start;
    PageHeader {
        title: SettingsText.page-alerts;
        subtitle: CombatText.page-subtitle;
    }

    // 第 1 组：总开关与状态。
    SettingRow {
        // 总开关在配置方案里：不同方案可以分别开关（例如挖矿方案打开、PVP 方案关掉）。
        title: CombatText.enable-toggle;
        description: CombatText.enable-help;
        Switch {
            checked <=> AlertsModel.enabled;
            toggled => {
                AlertsModel.edited();
            }
        }
    }
    RowGap { }
    SettingRow {
        title: CombatText.status-label;
        Text {
            text: AlertsModel.status-text;
            color: Theme.text-secondary;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-alignment: right;
            // 状态文字可能较长，限制宽度并换行，不把左边的名字挤没。
            max-width: 380px;
        }
    }

    // 第 2 组：日志目录。空着时自动查找；可以填 logs 或 logs\Gamelogs。
    SectionHeader { text: CombatText.log-directory-header; }
    SettingRow {
        title: CombatText.log-directory-label;
        description: CombatText.log-directory-help;
        // 右侧是两行控件（输入框与按钮），比默认行高，上下各留约 12px。
        min-height: 92px;
        // 输入框只在回车或离开时提交：填到一半的路径不写进配置。
        // 「使用自动位置」放在输入框下方：有的语言里按钮文字很长，与输入框并排会把左边的说明挤成窄条。
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            LineEdit {
                text <=> AlertsModel.log-directory;
                placeholder-text: AlertsModel.automatic-directory;
                // 路径通常较长，输入框比颜色框宽。
                width: 320px;
                accepted(text) => {
                    AlertsModel.edited();
                }
                changed has-focus => {
                    if !self.has-focus {
                        AlertsModel.edited();
                    }
                }
            }
            // 「使用自动位置」：清空输入框，只在填了路径时可点。
            HorizontalLayout {
                alignment: end;
                Button {
                    text: CombatText.use-automatic-location;
                    enabled: AlertsModel.log-directory != "";
                    clicked => {
                        AlertsModel.log-directory = "";
                        AlertsModel.edited();
                    }
                }
            }
        }
    }

    // 第 3 组：闪烁的外观。颜色与样式改动后下一次重算即生效，正在闪的缩略图立即换色。
    SectionHeader { text: CombatText.appearance-header; }
    SettingRow {
        title: CombatText.flash-color;
        ColorField {
            swatch: AlertsModel.swatch;
            hex <=> AlertsModel.color;
            edited => { AlertsModel.edited(); }
        }
    }
    RowGap { }
    SettingRow {
        title: CombatText.duration;
        description: CombatText.duration-help;
        Slider {
            value <=> AlertsModel.duration;
            minimum: 1;
            maximum: 10;
            step: 0.5;
            width: 200px;
            changed(v) => { AlertsModel.edited(); }
        }
        ValueLabel { text: CombatText.seconds(Math.round(AlertsModel.duration * 2) / 2); }
    }
    RowGap { }
    SettingRow {
        title: CombatText.style;
        description: CombatText.style-help;
        ComboBox {
            // 顺序同 CombatAlertStyle：border、wash、both。
            model: [CombatText.style-border, CombatText.style-wash, CombatText.style-both];
            current-index <=> AlertsModel.style;
            width: 140px;
            selected(v) => { AlertsModel.edited(); }
        }
    }

    // 第 4 组：触发条件。
    // 第 4 组：哪些受击会触发，规则见 Core 的战斗日志解析（M6 移植）。
    SectionHeader { text: CombatText.triggers-header; }
    SettingRow {
        title: CombatText.include-misses;
        description: CombatText.include-misses-help;
        Switch {
            checked <=> AlertsModel.include-misses;
            toggled => {
                AlertsModel.edited();
            }
        }
    }
    RowGap { }
    SettingRow {
        title: CombatText.minimum-damage;
        description: CombatText.minimum-damage-help;
        SpinBox {
            value <=> AlertsModel.minimum-damage;
            minimum: 1;
            // 范围同配置校验（1～100,000）；输入框里打的数超出范围时由 SpinBox 夹回。
            maximum: 100000;
            width: 140px;
            edited(v) => { AlertsModel.edited(); }
        }
    }

    // 第 5 组：「测试闪烁」不要求开关已打开。
    SectionHeader { text: CombatText.test-header; }
    SettingRow {
        title: CombatText.test-flash;
        description: CombatText.test-flash-help;
        Button {
            // 按钮与行名相同，一眼能对上。
            text: CombatText.test-flash;
            clicked => {
                AlertsModel.test-flash();
            }
        }
    }
    Footnote {
        text: CombatText.footnote;
    }
    // 页底留白。
    Rectangle { height: 24px; }
}
