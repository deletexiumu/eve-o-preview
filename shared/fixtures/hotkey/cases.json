  "mouseMatcher": [
    {
      "name": "游戏范围：前台是 EVE 才触发，按下的松开也吞掉",
      "steps": [
        {
          "op": "bindings",
          "bindings": [
            {
              "id": 1,
              "hotkey": "ctrl+Mouse4",
              "scope": "game"
            }
          ]
        },
        {
          "op": "check",
          "shouldListen": false,
          "hasActiveBinding": false
        },
        {
          "op": "down",
          "hotkey": "ctrl+Mouse4",
          "expect": "pass"
        },
        {
          "op": "up",
          "hotkey": "Mouse4",
          "expect": "pass"
        },
        {
          "op": "frontmost",
          "value": true
        },
        {
          "op": "check",
          "shouldListen": true,
          "hasActiveBinding": true
        },
        {
          "op": "down",
          "hotkey": "Mouse4",
          "expect": "pass"
        },
        {
          "op": "up",
          "hotkey": "Mouse4",
          "expect": "pass"
        },
        {
          "op": "down",
          "hotkey": "ctrl+Mouse4",
          "expect": "fire:1"
        },
        {
          "op": "dragged",
          "hotkey": "Mouse4",
          "expect": "swallow"
        },
        {
          "op": "dragged",
          "hotkey": "Mouse3",
          "expect": "pass"
        },
        {
          "op": "up",
          "hotkey": "Mouse4",
          "expect": "swallow"
        },
        {
          "op": "up",
          "hotkey": "Mouse4",
          "expect": "pass"
        }
      ]
    },
    {
      "name": "按下后离开游戏：松开照样吞掉，等松开有时限",
      "steps": [
        {
          "op": "bindings",
          "bindings": [
            {
              "id": 1,
              "hotkey": "Mouse5",
              "scope": "game"
            }
          ]
        },
        {
          "op": "frontmost",
          "value": true
        },
        {
          "op": "down",
          "hotkey": "Mouse5",
          "expect": "fire:1"
        },
        {
          "op": "frontmost",
          "value": false
        },
        {
          "op": "check",
          "shouldListen": true,
          "hasActiveBinding": false
        },
        {
          "op": "refresh",
          "now": 100,
          "expect": 110
        },
        {
          "op": "refresh",
          "now": 105,
          "expect": 110
        },
        {
          "op": "up",
          "hotkey": "shift+Mouse5",
          "expect": "swallow"
        },
        {
          "op": "check",
          "shouldListen": false,
          "hasActiveBinding": false
        },
        {
          "op": "refresh",
          "now": 106,
          "expect": null
        },
        {
          "op": "down",
          "hotkey": "Mouse5",
          "expect": "pass"
        },
        {
          "op": "frontmost",
          "value": true
        },
        {
          "op": "down",
          "hotkey": "Mouse5",
          "expect": "fire:1"
        },
        {
          "op": "frontmost",
          "value": false
        },
        {
          "op": "refresh",
          "now": 200,
          "expect": 210
        },
        {
          "op": "refresh",
          "now": 210,
          "expect": null
        },
        {
          "op": "check",
          "shouldListen": false,
          "hasActiveBinding": false
        },
        {
          "op": "up",
          "hotkey": "Mouse5",
          "expect": "pass"
        }
      ]
    },
    {
      "name": "暂停、替换绑定与钩子被摘掉",
      "steps": [
        {
          "op": "bindings",
          "bindings": [
            {
              "id": 1,
              "hotkey": "Mouse3",
              "scope": "global"
            },
            {
              "id": 2,
              "hotkey": "Mouse3",
              "scope": "global"
            }
          ]
        },
        {
          "op": "refresh",
          "now": 0,
          "expect": null
        },
        {
          "op": "down",
          "hotkey": "Mouse3",
          "expect": "fire:1"
        },
        {
          "op": "suspended",
          "value": true
        },
        {
          "op": "up",
          "hotkey": "Mouse3",
          "expect": "swallow"
        },
        {
          "op": "down",
          "hotkey": "Mouse3",
          "expect": "pass"
        },
        {
          "op": "check",
          "shouldListen": false,
          "hasActiveBinding": false
        },
        {
          "op": "suspended",
          "value": false
        },
        {
          "op": "down",
          "hotkey": "Mouse3",
          "expect": "fire:1"
        },
        {
          "op": "bindings",
          "bindings": [
            {
              "id": 7,
              "hotkey": "alt+Mouse4",
              "scope": "global"
            }
          ]
        },
        {
          "op": "down",
          "hotkey": "opt+Mouse4",
          "expect": "fire:7"
        },
        {
          "op": "up",
          "hotkey": "Mouse3",
          "expect": "swallow"
        },
        {
          "op": "hookRemoved"
        },
        {
          "op": "up",
          "hotkey": "Mouse4",
          "expect": "pass"
        },
        {
          "op": "down",
          "hotkey": "alt+Mouse4",
          "expect": "fire:7"
        },
        {
          "op": "down",
          "hotkey": "Mouse4",
          "expect": "pass"
        },
        {
          "op": "up",
          "hotkey": "Mouse4",
          "expect": "pass"
        }
      ]
    }
  ],
