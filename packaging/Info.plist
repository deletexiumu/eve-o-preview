<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SPDX-License-Identifier: GPL-3.0-or-later
  EVE-O Preview 的 Info.plist 模板（架构文档 9.1 节）。
  scripts/build-app.sh 把 __VERSION__ 换成环境变量 VERSION（默认取仓库根目录的 VERSION 文件）；
  有 packaging/AppIcon.png 时再加上 CFBundleIconFile。
  不写屏幕录制、辅助功能的用途说明键：这两项权限的系统弹窗文字由系统提供（架构文档 4.4 节）。
  NSDocumentsFolderUsageDescription 是读「文稿」里游戏日志时系统提示的说明（反馈文档 7.9 节）。
  Info.plist 的文字不随界面语言变化（没有资源目录），所以用英文。
-->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>io.github.deletexiumu.eveopreview-macos</string>
	<key>CFBundleName</key>
	<string>EVE-O Preview</string>
	<key>CFBundleDisplayName</key>
	<string>EVE-O Preview</string>
	<key>CFBundleExecutable</key>
	<string>EVEOPreview</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__VERSION__</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>EVE-O Preview reads EVE game logs in Documents/EVE/logs to flash a thumbnail when its character is attacked.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Licensed under GPL-3.0-or-later. Re-implementation of EveOPlus/eve-o-preview for macOS.</string>
</dict>
</plist>
